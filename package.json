{
  "name": "green-ecolution.de",
  "private": true,
  "version": "1.21.2",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/check-build-output.mjs",
    "preview": "astro preview",
    "lint": "pnpm fmt:check && astro check && eslint . --report-unused-disable-directives --max-warnings 0 && node scripts/check-i18n-parity.mjs",
    "lint:ci": "astro check && eslint . --report-unused-disable-directives --max-warnings 0 && node scripts/check-i18n-parity.mjs",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "test": "vitest run",
    "showcase:clips": "node scripts/fetch-showcase-clips.mjs",
    "showcase:build": "VIDEO_BASE_URL=/showcase-clips astro check && VIDEO_BASE_URL=/showcase-clips astro build && node scripts/check-build-output.mjs",
    "showcase:kiosk": "bash scripts/showcase-kiosk.sh"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/react": "^7.1.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@react-three/fiber": "^9.8.2",
    "@splidejs/react-splide": "^0.7.12",
    "astro": "^7.4.2",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-dom": "^5.30.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-react-x": "^5.30.5",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@10.20.0"
}
