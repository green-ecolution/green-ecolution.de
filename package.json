{
  "name": "green-ecolution.de",
  "private": true,
  "version": "1.11.3",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/check-build-output.mjs",
    "preview": "astro preview",
    "lint": "pnpm fmt:check && astro check && eslint . --report-unused-disable-directives --max-warnings 0 && node scripts/check-i18n-parity.mjs",
    "lint:ci": "astro check && eslint . --report-unused-disable-directives --max-warnings 0 && node scripts/check-i18n-parity.mjs",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/react": "^6.0.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@react-three/fiber": "^9.7.0",
    "@splidejs/react-splide": "^0.7.12",
    "astro": "^7.2.5",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-player": "^3.4.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-react-dom": "^5.18.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "eslint-plugin-react-x": "^5.18.6",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.20.0"
}
