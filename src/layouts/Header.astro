---
import HeaderLogo from '../components/islands/HeaderLogo'
import MainNavigation from '../components/islands/MainNavigation'
import LanguageSwitcher from '../components/LanguageSwitcher.astro'
import { pickStrings } from '../i18n/pick'
import { getTranslations } from '../i18n/t'
import type { Language } from '../i18n/languages'

interface Props {
  language: Language
}

const { language } = Astro.props
const t = getTranslations(language, 'common')

const pathname = Astro.url.pathname

const link = (label: string, path: string, description?: string) => {
  const href = `/${language}/${path}`
  return {
    label,
    href,
    description,
    active: pathname === href || pathname.startsWith(`${href}/`),
  }
}

const group = (id: string, label: string, items: ReturnType<typeof link>[]) => ({
  id,
  label,
  items,
  active: items.some((item) => item.active),
})

const entries = [
  group('product', t('nav.product'), [
    link(t('nav.platform'), 'product', t('nav.descriptions.platform')),
    link(t('nav.streamlet'), 'streamlet', t('nav.descriptions.streamlet')),
    link(t('nav.releases'), 'releases', t('nav.descriptions.releases')),
  ]),
  link(t('nav.services'), 'services'),
  group('company', t('nav.company'), [
    link(t('nav.about'), 'about', t('nav.descriptions.about')),
    link(t('nav.blog'), 'blog', t('nav.descriptions.blog')),
    link(t('nav.press'), 'presse', t('nav.descriptions.press')),
  ]),
  link(t('nav.contact'), 'contact'),
]

// Exactly the keys the island renders itself. The labels above and the language
// switcher below are already resolved markup and need no entry here.
const navStrings = pickStrings(language, 'common', [
  'nav.ariaLabel',
  'nav.tryNow',
  'nav.imprint',
  'nav.privacy',
  'header.openNavigation',
])
---

<a
  href="#main-content"
  class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:bg-white focus:px-6 focus:py-3 focus:rounded-lg focus:shadow-lg focus:text-green-dark-900 focus:font-semibold focus:border-2 focus:border-green-middle-900 focus:outline-none focus:ring-2 focus:ring-green-middle-900 focus:ring-offset-2 transition-all"
>
  {t('header.skipToContent')}
</a>
<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 pt-[env(safe-area-inset-top)] transition-all ease-in-out duration-300 bg-white/0"
>
  <!-- Safari 26 tints its status bar from a fixed top bar, but stops sampling
       one that carries a backdrop-filter itself. -->
  <div
    id="site-header-blur"
    aria-hidden="true"
    class="absolute inset-0 -z-10 transition-all ease-in-out duration-300"
  ></div>
  <div class="relative px-4 py-5 max-w-screen-lg mx-auto flex justify-between items-center md:px-6 xl:max-w-screen-xl">
    <a
      href={`/${language}`}
      aria-label={t('header.logoAriaLabel')}
      class="flex items-center gap-x-4 xl:gap-x-5"
    >
      <figure class="w-24 xl:w-28">
        <!-- The static SVG renders on the server already; the animation and
             lottie-web can wait until the browser is idle. -->
        <HeaderLogo client:idle transition:persist />
      </figure>
      <p class="hidden whitespace-nowrap text-green-dark-900 font-lato font-semibold text-xl xl:block xl:text-2xl">
        Green Ecolution
      </p>
    </a>

    <!-- Desktop shows the links as plain markup and src/scripts/navDropdown.ts
         opens the panels; only the drawer needs state, so the island hydrates
         below the lg breakpoint. -->
    <MainNavigation
      client:media="(max-width: 1023px)"
      entries={entries}
      imprintHref={`/${language}/impressum`}
      privacyHref={`/${language}/datenschutz`}
      demoHref="https://demo.green-ecolution.de"
      strings={navStrings}
    >
      <LanguageSwitcher language={language} />
    </MainNavigation>
  </div>

  <!-- Inside the header so Safari finds a single fixed bar at the top edge. -->
  <div
    id="scroll-progress"
    class="absolute top-0 inset-x-0 h-1 origin-left bg-gradient-to-r from-green-dark-900 via-green-middle-900 to-green-light-900"
    style="transform: scaleX(0); will-change: transform;"
  ></div>
</header>
