---
import HeaderLogo from '../components/islands/HeaderLogo'
import MainNavigation from '../components/islands/MainNavigation'
import LanguageSwitcher from '../components/LanguageSwitcher.astro'
import { pickStrings } from '../i18n/pick'
import { getTranslations } from '../i18n/t'
import type { Language } from '../i18n/languages'

interface Props {
  language: Language
}

const { language } = Astro.props
const t = getTranslations(language, 'common')

const pathname = Astro.url.pathname

const links = [
  { label: t('nav.project'), href: `/${language}/project` },
  { label: t('nav.streamlet'), href: `/${language}/streamlet` },
  { label: t('nav.releases'), href: `/${language}/releases` },
  { label: t('nav.blog'), href: `/${language}/blog` },
  { label: t('nav.contact'), href: `/${language}/contact` },
].map((link) => ({
  ...link,
  active: pathname === link.href || pathname.startsWith(`${link.href}/`),
}))

// Exactly the keys the island renders itself. The labels above and the language
// switcher below are already resolved markup and need no entry here.
const navStrings = pickStrings(language, 'common', [
  'nav.ariaLabel',
  'nav.heading',
  'nav.tryNow',
  'nav.imprint',
  'nav.privacy',
  'header.openNavigation',
])
---

<a
  href="#main-content"
  class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:bg-white focus:px-6 focus:py-3 focus:rounded-lg focus:shadow-lg focus:text-green-dark-900 focus:font-semibold focus:border-2 focus:border-green-middle-900 focus:outline-none focus:ring-2 focus:ring-green-middle-900 focus:ring-offset-2 transition-all"
>
  {t('header.skipToContent')}
</a>
<header
  id="site-header"
  class="fixed inset-x-0 top-[var(--voting-banner-height,0px)] z-50 transition-all ease-in-out duration-300 bg-transparent"
>
  <div
    class="relative px-4 py-5 max-w-screen-lg mx-auto flex justify-between items-center md:px-6 xl:max-w-screen-xl"
  >
    <a
      href={`/${language}`}
      aria-label={t('header.logoAriaLabel')}
      class="flex items-center gap-x-4 xl:gap-x-5"
    >
      <figure class="w-24 xl:w-28">
        <!-- The static SVG renders on the server already; the animation and
             lottie-web can wait until the browser is idle. -->
        <HeaderLogo client:idle transition:persist />
      </figure>
      <p
        class="hidden whitespace-nowrap text-green-dark-900 font-lato font-semibold text-xl xl:block xl:text-2xl"
      >
        Green Ecolution
      </p>
    </a>

    <!-- Desktop shows the links as plain markup; only the mobile menu needs
         state, so the island hydrates below the lg breakpoint. -->
    <MainNavigation
      client:media="(max-width: 1023px)"
      links={links}
      imprintHref={`/${language}/impressum`}
      privacyHref={`/${language}/datenschutz`}
      demoHref="https://demo.green-ecolution.de"
      strings={navStrings}
    >
      <LanguageSwitcher language={language} />
    </MainNavigation>
  </div>
</header>
