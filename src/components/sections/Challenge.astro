---
import type { Language } from '../../i18n/languages'
import { getTranslations } from '../../i18n/t'
import { challengeFigures } from '../../data/challengeFigures'

interface Props {
  language: Language
}

const { language } = Astro.props
const t = getTranslations(language, 'home')

const CROSSHATCH =
  'linear-gradient(45deg, white 1px, transparent 1px), linear-gradient(-45deg, white 1px, transparent 1px)'
---

<section class="relative overflow-hidden">
  <div class="bg-gradient-to-b from-[#1e3a1a] via-green-dark-900 to-green-middle-900/90">
    <div
      class="absolute inset-0 opacity-[0.03]"
      style={`background-image: ${CROSSHATCH}; background-size: 40px 40px;`}
    >
    </div>

    <div
      class="absolute -top-20 left-1/4 w-[50rem] h-[30rem] bg-green-light-900/6 rounded-full blur-3xl rotate-12"
    >
    </div>
    <div
      class="absolute bottom-0 -right-20 w-[25rem] h-[25rem] bg-green-middle-900/8 rounded-full blur-3xl"
    >
    </div>

    <div
      class="relative z-10 max-w-208 mx-auto px-4 py-20 md:px-6 lg:py-28 lg:max-w-screen-lg xl:py-36 xl:max-w-screen-xl"
    >
      <div class="mb-12 lg:mb-16 xl:mb-20">
        <div>
          <span
            class="block mb-4 font-lato text-white/10 leading-none select-none"
            style="font-size: 5rem;"
            aria-hidden="true">&bdquo;</span
          >
        </div>

        <blockquote class="border-l-2 border-green-light-900/30 pl-6 lg:pl-8">
          <p
            class="font-lato text-2xl font-light italic text-white max-w-3xl md:text-3xl lg:text-4xl xl:text-5xl"
          >
            {t('challenge.quoteLine1')}
            <br />
            <span class="text-green-light-900">{t('challenge.quoteLine2')}</span>
          </p>
        </blockquote>
      </div>

      <div class="w-16 h-px bg-gradient-to-r from-green-light-900/50 to-transparent mb-10 lg:mb-14">
      </div>

      <p class="text-white/70 leading-relaxed max-w-3xl mb-12 lg:mb-16 lg:text-lg">
        {t('challenge.supportingText')}
      </p>

      <div class="grid grid-cols-1 gap-4 md:grid-cols-3 lg:gap-6">
        {
          challengeFigures.map((figure) => (
            <article class="group bg-white/[0.07] backdrop-blur-sm rounded-2xl p-6 lg:p-8 border border-white/10 transition-all duration-300 hover:-translate-y-0.5 hover:bg-white/10 hover:shadow-lg">
              <div class="mb-3">
                <span class="font-lato text-3xl font-bold text-white tracking-tight lg:text-4xl xl:text-5xl">
                  {t(`challenge.figures.${figure.id}.value`)}
                </span>
              </div>
              <span class="inline-block text-xs font-semibold tracking-widest uppercase text-green-light-900 mb-3">
                {t(`challenge.figures.${figure.id}.unit`)}
              </span>
              <p class="text-white/60 text-sm leading-relaxed">
                {t(`challenge.figures.${figure.id}.description`)}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
