---
import type { Language } from '../../i18n/languages'
import { getTranslations } from '../../i18n/t'
import { Image } from 'astro:assets'
import setupPhoto from '../../assets/photos/sensor-einrichtung-app-qr.jpg'

interface Props {
  language: Language
}

const { language } = Astro.props
const t = getTranslations(language, 'home')
---

<section class="-mt-4 mb-20 lg:-mt-8 lg:mb-28 xl:-mt-12 xl:mb-36">
  <div class="px-4 max-w-208 mx-auto md:px-6 lg:max-w-screen-lg xl:max-w-screen-xl">
    <div class="lg:grid lg:grid-cols-12 lg:gap-10 lg:items-center">
      <div class="lg:col-span-5 lg:order-2">
        <div class="inline-block mb-6">
          <span class="text-xs font-semibold tracking-widest text-green-light-900 uppercase">
            {t('sensorSetup.sectionLabel')}
          </span>
          <div class="h-0.5 w-12 bg-gradient-to-r from-green-light-900 to-transparent mt-1"></div>
        </div>

        <h2 class="font-lato font-bold text-2xl mb-4 text-grey-900 lg:text-3xl">
          {t('sensorSetup.title')}
        </h2>

        <p class="text-grey-900/70 leading-relaxed">{t('sensorSetup.description')}</p>
      </div>

      <figure class="mt-10 lg:mt-0 lg:col-span-7 lg:order-1">
        <Image
          src={setupPhoto}
          alt={t('sensorSetup.photoAlt')}
          widths={[640, 960, 1280]}
          sizes="(min-width: 1024px) 58vw, 100vw"
          loading="lazy"
          class="w-full aspect-[16/10] object-cover rounded-xl"
        />

        <figcaption class="mt-3 text-sm text-grey-900/60">
          {t('sensorSetup.photoCaption')}
        </figcaption>
      </figure>
    </div>
  </div>
</section>
