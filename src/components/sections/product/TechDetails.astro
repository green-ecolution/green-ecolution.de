---
import type { Language } from '../../../i18n/languages'
import { getTranslations } from '../../../i18n/t'
import { splitSlot } from '../../../lib/slotText'
import Accordion from '../../Accordion.astro'

interface Props {
  language: Language
}

const ROWS = ['radio', 'interfaces', 'routes', 'access', 'operation', 'licence'] as const

const LINK =
  'font-semibold text-green-dark-900 underline decoration-green-dark-900 decoration-2 underline-offset-2 transition-all hover:decoration-4'

const { language } = Astro.props
const t = getTranslations(language, 'product')
const streamlet = splitSlot(t('tech.items.routes.textRich'), 'streamlet')
---

<div id="architecture" class="mt-10 lg:mt-12">
  <Accordion summary={t('tech.summary')} data-open-on-anchor>
    <dl class="grid gap-x-8 gap-y-1 lg:grid-cols-[12rem_1fr] lg:gap-y-4">
      {ROWS.map((row) => (
        <>
          <dt class="font-lato font-semibold text-grey-900 not-first:mt-3 lg:not-first:mt-0">
            {t(`tech.items.${row}.term`)}
          </dt>
          <dd>
            {row === 'routes' ? (
              <>
                {streamlet.before}
                <a href={`/${language}/streamlet`} class={LINK}>
                  {streamlet.inner}
                </a>
                {streamlet.after}
              </>
            ) : (
              t(`tech.items.${row}.text`)
            )}
          </dd>
        </>
      ))}
    </dl>
  </Accordion>
</div>

<script>
  import '../../../scripts/openOnAnchor'
</script>
