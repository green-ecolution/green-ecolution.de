---
import type { Language } from '../../i18n/languages'
import { getTranslations } from '../../i18n/t'
import { renderSlots, type SlotTag } from '../../lib/slotText'

interface Props {
  language: Language
}

const { language } = Astro.props

const LINK_CLASS =
  'text-green-dark-900 font-semibold underline underline-offset-2 transition-all ease-in-out duration-300 hover:text-green-light-900'

const link = (href: string): SlotTag => ({
  open: `<a href="${href}" target="_blank" rel="noopener noreferrer" class="${LINK_CLASS}">`,
  close: '</a>',
})

// The existing link() forces target="_blank"; that is wrong for our own pages.
const internalLink = (href: string): SlotTag => ({
  open: `<a href="${href}" class="${LINK_CLASS}">`,
  close: '</a>',
})

const LINKS = {
  hsfl: link('https://hs-flensburg.de/'),
  progeek: link('https://progeek.de/'),
  grenzregion: link('https://smarte-grenzregion.de/'),
  flensburg: link('https://www.flensburg.de/'),
  repo: link('https://github.com/green-ecolution'),
  watermark: link('https://www.irrometer.com/pdf/403.pdf'),
  smt100: link('https://www.truebner.de/de/smt100.php'),
}

const p = (className?: string): SlotTag => ({
  open: className ? `<p class="${className}">` : '<p>',
  close: '</p>',
})

// One tag map per answer, mirroring the components prop of the react <Trans>.
const ITEMS = [
  {
    id: 'origin',
    wrap: false,
    tags: {
      p1: p('mb-4'),
      p2: p('mb-4'),
      p3: p(),
      hsfl: LINKS.hsfl,
      grenzregion: LINKS.grenzregion,
      progeek: LINKS.progeek,
    },
  },
  { id: 'value', wrap: false, tags: { p1: p('mb-4'), p2: p() } },
  {
    id: 'requirements',
    wrap: false,
    tags: {
      p1: p('mb-4'),
      p2: p(),
      requirements: internalLink(`/${language}/project#requirements`),
    },
  },
  {
    id: 'openSource',
    wrap: false,
    tags: { p1: p('mb-4'), p2: p(), repo: LINKS.repo },
  },
  {
    id: 'sensors',
    wrap: false,
    tags: {
      p1: p('mb-4'),
      p2: p('mb-4'),
      p3: p(),
      watermark: LINKS.watermark,
      smt100: LINKS.smt100,
    },
  },
  {
    id: 'progress',
    wrap: false,
    tags: {
      p1: p(),
      p2: p('mt-4'),
      p3: p('mt-4'),
      hsfl: LINKS.hsfl,
      program: { open: '<strong>', close: '</strong>' },
      funding: { open: '<strong>', close: '</strong>' },
      progeek: LINKS.progeek,
      flensburg: LINKS.flensburg,
      grenzregion: LINKS.grenzregion,
    },
  },
] as const

const t = getTranslations(language, 'home')

// Single source of truth: the JSON-LD schema reads answerPlain, the accordion
// renders answerRich, both kept in sync in the translation catalog.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: ITEMS.map((item) => ({
    '@type': 'Question',
    name: t(`faq.items.${item.id}.question`),
    acceptedAnswer: {
      '@type': 'Answer',
      text: t(`faq.items.${item.id}.answerPlain`),
    },
  })),
}

const answers = ITEMS.map((item) => {
  const html = renderSlots(t(`faq.items.${item.id}.answerRich`), item.tags)
  return {
    id: item.id,
    question: t(`faq.items.${item.id}.question`),
    html: item.wrap ? `<p>${html}</p>` : html,
  }
})
---

<section class="px-4 max-w-208 mx-auto my-20 md:px-6 lg:my-28 xl:my-36 xl:max-w-screen-lg">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

  <div class="mb-6 lg:mb-8 flex justify-center">
    <div class="inline-block">
      <span class="text-xs font-semibold tracking-widest text-green-light-900 uppercase">
        {t('faq.sectionLabel')}
      </span>
      <div class="h-0.5 w-12 bg-gradient-to-r from-green-light-900 to-transparent mt-1 mx-auto">
      </div>
    </div>
  </div>

  <h2 class="font-lato font-bold text-center text-2xl mb-8 text-grey-900 lg:mb-12 lg:text-3xl">
    {t('faq.title')}
  </h2>

  <ul class="flex flex-col gap-y-4 md:gap-y-5">
    {
      answers.map((answer) => (
        <li>
          <details class="accordion border bg-white rounded-2xl transition-all duration-300 border-green-dark-900/30 shadow-md hover:shadow-lg hover:border-green-dark-900/50 open:border-green-light-900 open:shadow-lg open:shadow-green-light-900/20">
            <summary class="w-full px-4 py-4 cursor-pointer flex items-center justify-between gap-x-4 font-semibold font-lato text-grey-900 transition-all ease-out duration-150 md:px-6 md:py-5 rounded-2xl hover:bg-green-dark-900/5 active:bg-green-dark-900/10 open:bg-green-light-900/10 open:rounded-t-2xl">
              <span class="w-[85%] text-left lg:text-lg">{answer.question}</span>
              <span
                aria-hidden="true"
                class="accordion-chevron w-8 h-8 rounded-full text-white flex items-center justify-center transition-all ease-in-out duration-300 bg-green-dark-900 shrink-0"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="size-6"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="m19.5 8.25-7.5 7.5-7.5-7.5"
                  />
                </svg>
              </span>
            </summary>
            <div
              class="accordion-panel text-base text-grey-900/80 leading-relaxed px-4 border-t border-t-green-light-900/30 pt-3 pb-4 md:px-6 md:pb-6"
              set:html={answer.html}
            />
          </details>
        </li>
      ))
    }
  </ul>
</section>

<style>
  /* The react accordion animated a max-height transition. details cannot do that
     without script; interpolate-size gets it where the browser supports it, and
     everywhere else the panel simply appears. Keyboard and screen reader
     behaviour comes from the browser now instead of hand-built aria-expanded. */
  .accordion {
    interpolate-size: allow-keywords;
  }

  .accordion::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 300ms ease-in-out,
      content-visibility 300ms allow-discrete;
  }

  .accordion[open]::details-content {
    block-size: auto;
  }

  .accordion summary::-webkit-details-marker,
  .accordion summary::marker {
    display: none;
    content: '';
  }

  .accordion[open] .accordion-chevron {
    transform: rotate(180deg);
    background-color: var(--color-green-light-900);
    box-shadow: 0 4px 6px -1px color-mix(in oklab, var(--color-green-light-900) 30%, transparent);
  }
</style>
