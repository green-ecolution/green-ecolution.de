---
import { Clock, Package, RefreshCw, Route } from 'lucide-react'
import type { Language } from '../../i18n/languages'
import { getTranslations } from '../../i18n/t'
import Arrow from '../icons/Arrow.astro'
import Button from '../Button.astro'

interface Props {
  language: Language
}

const PRICING_ITEMS = [
  { id: 'oneTime', icon: Package },
  { id: 'recurring', icon: RefreshCw },
  { id: 'effort', icon: Clock },
  { id: 'separate', icon: Route },
] as const

const { language } = Astro.props
const t = getTranslations(language, 'services')
---

<section
  id="pricing"
  class="px-4 max-w-208 mx-auto my-20 md:px-6 lg:my-28 lg:max-w-screen-lg xl:my-36 xl:max-w-screen-xl"
>
  <div class="inline-block mb-4">
    <span class="text-xs font-semibold tracking-widest text-green-light-900 uppercase">
      {t('pricing.sectionLabel')}
    </span>
    <div class="h-0.5 w-12 bg-gradient-to-r from-green-light-900 to-transparent mt-1"></div>
  </div>

  <div class="mb-10 lg:mb-14 lg:flex lg:justify-between lg:gap-12 xl:gap-16">
    <h2 class="font-lato font-bold text-2xl mb-4 text-grey-900 lg:mb-0 lg:max-w-xs lg:shrink-0 lg:text-3xl xl:max-w-sm xl:text-4xl">
      {t('pricing.title')}
    </h2>
    <p class="text-grey-900/70 leading-relaxed lg:max-w-2xl">{t('pricing.description')}</p>
  </div>

  <dl class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4 lg:gap-5">
    {PRICING_ITEMS.map(({ id, icon: Icon }) => (
      <div class="h-full rounded-2xl border border-green-dark-900/10 bg-white p-5 lg:p-6">
        <dt class="font-lato font-semibold text-green-dark-900 mb-2">
          <span class="flex w-10 h-10 rounded-lg bg-green-light-900/15 items-center justify-center mb-4">
            <Icon className="w-5 h-5 text-green-dark-900" aria-hidden="true" />
          </span>
          {t(`pricing.items.${id}.label`)}
        </dt>
        <dd class="text-grey-900/70 leading-relaxed">{t(`pricing.items.${id}.description`)}</dd>
      </div>
    ))}
  </dl>

  <p class="text-grey-900/70 leading-relaxed mt-8 max-w-2xl">{t('pricing.selfHosting')}</p>

  <div class="mt-8">
    <Button href={`/${language}/contact`} ariaLabel={t('pricing.ctaAriaLabel')} isDark>
      <span>{t('pricing.cta')}</span>
      <Arrow class="w-6 transition-all ease-in-out duration-300 group-hover:translate-x-2" />
    </Button>
  </div>
</section>
