---
import { Cpu, LifeBuoy, MonitorSmartphone, Wrench } from 'lucide-react'
import type { Language } from '../../i18n/languages'
import { getTranslations } from '../../i18n/t'
import Arrow from '../icons/Arrow.astro'
import Button from '../Button.astro'

interface Props {
  language: Language
}

// Same icons as the matching items on the services page.
const OFFER_ITEMS = [
  { id: 'software', icon: MonitorSmartphone },
  { id: 'sensors', icon: Cpu },
  { id: 'setup', icon: Wrench },
  { id: 'operation', icon: LifeBuoy },
] as const

const { language } = Astro.props
const t = getTranslations(language, 'home')
---

<section class="px-4 max-w-208 mx-auto my-20 md:px-6 lg:my-28 lg:max-w-screen-lg xl:my-36 xl:max-w-screen-xl">
  <div class="inline-block mb-4">
    <span class="text-xs font-semibold tracking-widest text-green-light-900 uppercase">
      {t('offer.sectionLabel')}
    </span>
    <div class="h-0.5 w-12 bg-gradient-to-r from-green-light-900 to-transparent mt-1"></div>
  </div>

  <div class="mb-10 lg:mb-14 lg:flex lg:justify-between lg:gap-12 xl:gap-16">
    <h2 class="font-lato font-bold text-2xl mb-4 text-grey-900 lg:mb-0 lg:max-w-xs lg:shrink-0 lg:text-3xl xl:max-w-sm xl:text-4xl">
      {t('offer.title')}
    </h2>
    <p class="text-grey-900/70 leading-relaxed lg:max-w-2xl">{t('offer.description')}</p>
  </div>

  <ul class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4 lg:gap-5">
    {OFFER_ITEMS.map(({ id, icon: Icon }) => (
      <li class="h-full rounded-2xl border border-green-dark-900/10 bg-white p-5 lg:p-6">
        <span class="flex w-10 h-10 rounded-lg bg-green-light-900/15 items-center justify-center mb-4">
          <Icon className="w-5 h-5 text-green-dark-900" aria-hidden="true" />
        </span>
        <h3 class="font-lato font-semibold text-grey-900 mb-2">{t(`offer.items.${id}.label`)}</h3>
        <p class="text-grey-900/70 leading-relaxed">{t(`offer.items.${id}.description`)}</p>
      </li>
    ))}
  </ul>

  <div class="mt-8">
    <Button href={`/${language}/services`} ariaLabel={t('offer.ctaAriaLabel')} isDark>
      <span>{t('offer.cta')}</span>
      <Arrow class="w-6 transition-all ease-in-out duration-300 group-hover:translate-x-2" />
    </Button>
  </div>
</section>
