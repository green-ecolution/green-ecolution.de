---
import { Cpu, LifeBuoy, MonitorSmartphone, Wrench } from 'lucide-react'
import type { Language } from '../../i18n/languages'
import { getTranslations } from '../../i18n/t'
import Arrow from '../icons/Arrow.astro'
import Button from '../Button.astro'

interface Props {
  language: Language
}

// Same icons as the matching items on the services page.
const OFFER_ITEMS = [
  { id: 'software', icon: MonitorSmartphone },
  { id: 'sensors', icon: Cpu },
  { id: 'setup', icon: Wrench },
  { id: 'operation', icon: LifeBuoy },
] as const

const { language } = Astro.props
const t = getTranslations(language, 'home')
---

<section class="px-4 max-w-208 mx-auto my-20 md:px-6 lg:my-28 lg:max-w-screen-lg lg:grid lg:grid-cols-12 lg:gap-10 xl:my-36 xl:max-w-screen-xl xl:gap-16">
  <div class="mb-10 lg:mb-0 lg:col-span-5">
    <div class="inline-block mb-4">
      <span class="text-xs font-semibold tracking-widest text-green-dark-900 uppercase">
        {t('offer.sectionLabel')}
      </span>
      <div class="h-0.5 w-12 bg-gradient-to-r from-green-light-900 to-transparent mt-1"></div>
    </div>

    <h2 class="font-lato font-bold text-2xl mb-4 text-grey-900 lg:text-3xl xl:text-4xl">
      {t('offer.title')}
    </h2>
    <p class="text-grey-900/70 leading-relaxed mb-8">{t('offer.description')}</p>

    <Button href={`/${language}/services`} ariaLabel={t('offer.ctaAriaLabel')} isDark>
      <span>{t('offer.cta')}</span>
      <Arrow class="w-6 transition-all ease-in-out duration-300 group-hover:translate-x-2" />
    </Button>
  </div>

  <ul class="grid grid-cols-1 gap-x-10 sm:grid-cols-2 lg:col-span-7">
    {OFFER_ITEMS.map(({ id, icon: Icon }) => (
      <li class="border-t border-green-dark-900/20 py-6">
        <h3 class="flex items-center gap-x-3 font-lato font-bold text-lg text-grey-900 mb-2 lg:text-xl">
          <Icon className="w-5 h-5 shrink-0 text-green-dark-900" aria-hidden="true" />
          {t(`offer.items.${id}.label`)}
        </h3>
        <p class="text-grey-900/70 leading-relaxed">{t(`offer.items.${id}.description`)}</p>
      </li>
    ))}
  </ul>
</section>
