---
import { Mail, CalendarDays } from 'lucide-react'
import type { Language } from '../../i18n/languages'
import { getTranslations } from '../../i18n/t'
import { company } from '../../data/company'

interface Props {
  language: Language
  spacingTop?: boolean
}

// Used by the contact page and the start page, so its keys live in the contact
// namespace rather than being maintained twice.
const { language, spacingTop = true } = Astro.props
const t = getTranslations(language, 'contact')

const cabOutline =
  'M100 49 V22 a4 4 0 0 1 4 -4 H124 q3.4 0 4.7 3.1 L133.3 33 q0.7 1.7 0.7 3.5 V49 Z'
const wheelCentres = [40, 57, 118]
const lugAngles = [0, 72, 144, 216, 288]
---

<section
  class:list={[
    'px-4 max-w-screen-lg mx-auto mb-20 md:px-6 lg:mb-28 xl:max-w-screen-xl xl:mb-36',
    spacingTop && 'mt-20 lg:mt-28 xl:mt-36',
  ]}
>
  <div class="relative bg-green-dark-900 rounded-2xl lg:rounded-3xl p-6 md:p-10 lg:p-12 shadow-xl overflow-hidden">
    <div class="absolute top-0 right-0 w-96 h-96 bg-green-light-900/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
    <div class="absolute bottom-0 left-0 w-64 h-64 bg-green-middle-900/20 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>
    <div
      class="absolute inset-0 opacity-5"
      style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 24px 24px;"
    ></div>

    <div class="relative z-10 flex flex-col lg:flex-row lg:items-center lg:gap-12">
      <div class="flex-1 text-center lg:text-left">
        <h2 class="font-lato font-bold text-2xl mb-4 lg:text-3xl xl:text-4xl text-white">
          {t('cta.headline')}
        </h2>
        <p class="text-white/90 mb-8 max-w-xl lg:max-w-none leading-relaxed">
          {t('cta.description')}
        </p>

        <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center lg:justify-start">
          <a
            href={`mailto:${company.email}`}
            aria-label={t('cta.mailAriaLabel')}
            class="group inline-flex items-center justify-center gap-x-3 rounded-xl font-semibold px-8 py-4 border-2 border-white bg-white text-green-dark-900 transition-all duration-300 hover:bg-green-light-100 hover:shadow-lg hover:shadow-black/20 hover:scale-105 active:scale-100"
          >
            <Mail className="w-5 h-5 transition-transform group-hover:-rotate-12" />
            <span>{t('cta.mailButtonLabel')}</span>
          </a>
          <a
            href={company.booking.overviewUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t('cta.bookingAriaLabel')}
            class="group inline-flex items-center justify-center gap-x-3 rounded-xl font-semibold px-8 py-4 border-2 border-white/70 text-white transition-all duration-300 hover:bg-white/10 hover:border-white hover:scale-105 active:scale-100"
          >
            <CalendarDays className="w-5 h-5 transition-transform group-hover:-rotate-12" />
            <span>{t('cta.bookingButtonLabel')}</span>
          </a>
        </div>
      </div>

      <div class="hidden lg:block flex-shrink-0 w-80 h-40 xl:w-96 xl:h-48">
        <div class="relative w-full h-full overflow-hidden" aria-hidden="true">
          <div class="absolute top-2 cloud-slow">
            <svg class="w-12 h-6 opacity-30" viewBox="0 0 48 24">
              <ellipse cx="24" cy="14" rx="20" ry="10" fill="white"></ellipse>
              <ellipse cx="14" cy="12" rx="10" ry="8" fill="white"></ellipse>
              <ellipse cx="34" cy="12" rx="12" ry="8" fill="white"></ellipse>
            </svg>
          </div>
          <div class="absolute top-6 cloud-fast">
            <svg class="w-8 h-4 opacity-20" viewBox="0 0 48 24">
              <ellipse cx="24" cy="14" rx="18" ry="8" fill="white"></ellipse>
              <ellipse cx="16" cy="12" rx="8" ry="6" fill="white"></ellipse>
            </svg>
          </div>

          <div class="absolute bottom-4 left-0 right-0 h-1.5 bg-white/25 rounded-full"></div>
          <div class="absolute bottom-5 left-0 right-0 flex justify-around opacity-20">
            {Array.from({ length: 12 }).map(() => (
              <div class="w-0.5 h-2 bg-white/40 rounded-full" />
            ))}
          </div>

          <svg class="absolute bottom-4 right-4 w-16 h-28" viewBox="0 0 64 112">
            <g fill="none" stroke="#6B4423" stroke-width="2.4" stroke-linecap="round">
              <path d="M31.5 78 Q26 70 21 60"></path>
              <path d="M32.5 74 Q38 67 44 58"></path>
            </g>
            <path
              d="M26.5 110 Q29.4 104 29.6 92 L30 52 H34 L34.4 92 Q34.6 104 37.5 110 Z"
              fill="#6B4423"
            ></path>
            <g fill="#4C7741">
              <circle cx="32" cy="22" r="17"></circle>
              <circle cx="19" cy="33" r="14"></circle>
              <circle cx="45" cy="33" r="14"></circle>
              <circle cx="16" cy="49" r="12"></circle>
              <circle cx="48" cy="49" r="12"></circle>
              <circle cx="32" cy="45" r="17"></circle>
            </g>
            <g fill="#3D5F35">
              <circle cx="41" cy="47" r="11"></circle>
              <circle cx="30" cy="54" r="8"></circle>
              <circle cx="48" cy="36" r="8"></circle>
            </g>
            <g fill="#5C8B4E">
              <circle cx="24" cy="21" r="9"></circle>
              <circle cx="15" cy="36" r="6"></circle>
              <circle cx="36" cy="13" r="6"></circle>
            </g>
          </svg>

          <svg class="absolute bottom-4 right-24 w-12 h-20" viewBox="0 0 48 80">
            <g fill="none" stroke="#5D4E37" stroke-width="2" stroke-linecap="round">
              <path d="M23.6 58 Q20 53 16 47"></path>
              <path d="M24.4 55 Q28 51 32 46"></path>
            </g>
            <path
              d="M20.2 78 Q22.3 74 22.4 66 L22.6 42 H25.4 L25.6 66 Q25.7 74 27.8 78 Z"
              fill="#5D4E37"
            ></path>
            <g fill="#7B9F35">
              <circle cx="24" cy="21" r="14"></circle>
              <circle cx="13" cy="30" r="11"></circle>
              <circle cx="35" cy="30" r="11"></circle>
              <circle cx="24" cy="36" r="13"></circle>
              <circle cx="15" cy="41" r="8"></circle>
              <circle cx="33" cy="41" r="8"></circle>
            </g>
            <g fill="#6A8C2E">
              <circle cx="31" cy="36" r="9"></circle>
              <circle cx="22" cy="43" r="6"></circle>
            </g>
            <g fill="#8DB13F">
              <circle cx="18" cy="19" r="7"></circle>
              <circle cx="28" cy="13" r="5"></circle>
              <circle cx="11" cy="30" r="4"></circle>
            </g>
          </svg>

          <svg class="absolute bottom-4 right-40 w-10 h-16 opacity-80" viewBox="0 0 40 64">
            <path
              d="M22.5 47.5 V61"
              stroke="#96683A"
              stroke-width="1.8"
              stroke-linecap="round"
            ></path>
            <path
              d="M20 44 Q17.5 40 15 36 M20 41 Q23 38 25.5 35"
              fill="none"
              stroke="#8B5A2B"
              stroke-width="1.4"
              stroke-linecap="round"
            ></path>
            <path
              d="M18 62 Q19 59 19 54 L19.2 30 H20.8 L21 54 Q21 59 22 62 Z"
              fill="#8B5A2B"
            ></path>
            <path
              d="M13.5 47.5 V62 M26.5 47.5 V62"
              stroke="#C08A52"
              stroke-width="2"
              stroke-linecap="round"
            ></path>
            <path d="M12 47 H28" stroke="#D09C62" stroke-width="2.2" stroke-linecap="round"></path>
            <g fill="#ACB63B">
              <circle cx="20" cy="16" r="10"></circle>
              <circle cx="12" cy="23" r="8"></circle>
              <circle cx="28" cy="23" r="8"></circle>
              <circle cx="20" cy="27" r="9"></circle>
            </g>
            <g fill="#9AAF35">
              <circle cx="25" cy="26" r="6"></circle>
            </g>
            <g fill="#BEC74E">
              <circle cx="16" cy="14" r="5"></circle>
              <circle cx="10" cy="22" r="3"></circle>
            </g>
          </svg>

          <div class="absolute bottom-3 watering-truck">
            <svg class="w-35 h-17" viewBox="0 0 140 68">
              <defs>
                <clipPath id="truck-tank-clip">
                  <rect x="22" y="19" width="72" height="25.5" rx="10" ry="12.75"></rect>
                </clipPath>
                <clipPath id="truck-cab-clip">
                  <path d={cabOutline}></path>
                </clipPath>
              </defs>

              <ellipse cx="78" cy="62.5" rx="60" ry="2.5" fill="rgba(0,0,0,0.18)"></ellipse>

              <g class="truck-water">
                <ellipse
                  class="truck-puddle"
                  cx="8"
                  cy="62"
                  rx="7.5"
                  ry="1.6"
                  fill="#7FC0EC"
                  opacity="0.55"
                ></ellipse>
                <g
                  class="truck-stream"
                  fill="none"
                  stroke="#8CCBF2"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-dasharray="2.6 3.2"
                >
                  <path d="M11.6 47.4 Q9.5 55 3.5 61.2"></path>
                  <path d="M12.5 47.4 Q11.8 55 8 61.5"></path>
                  <path d="M13.4 47.4 Q14 55 12.6 61.5"></path>
                </g>
              </g>

              <g class="truck-body">
                <path
                  d="M25 39.5 H17 a4.5 4.5 0 0 0 -4.5 4.5 v1"
                  fill="none"
                  stroke="#2B3A2E"
                  stroke-width="2.4"
                  stroke-linecap="round"
                ></path>
                <rect x="10.2" y="44.6" width="4.6" height="2.8" rx="1" fill="#C5CDBB"></rect>

                <rect x="19" y="44.5" width="96" height="4.5" rx="1.5" fill="#2B3A2E"></rect>
                <rect x="19" y="45.3" width="1.8" height="2.8" rx="0.6" fill="#E2553F"></rect>
                <path
                  d="M30.5 54.5 a9.5 9.5 0 0 1 9.5 -9.5 h17 a9.5 9.5 0 0 1 9.5 9.5"
                  fill="none"
                  stroke="#2B3A2E"
                  stroke-width="1.8"
                  stroke-linecap="round"
                ></path>
                <rect x="72" y="49" width="24" height="8.5" rx="1.5" fill="#33453A"></rect>
                <path
                  d="M80 50.5 v5.5 M88 50.5 v5.5"
                  stroke="#2B3A2E"
                  stroke-width="0.8"
                  stroke-linecap="round"
                ></path>
                <rect x="96" y="21" width="2.4" height="23.5" rx="1.2" fill="#2B3A2E"></rect>

                <path
                  d="M31 19.5 v-3 h54 v3"
                  fill="none"
                  stroke="#2B3A2E"
                  stroke-width="0.9"
                  stroke-linejoin="round"
                ></path>
                <rect x="52.5" y="15.8" width="11" height="3.6" rx="1.2" fill="#2B3A2E"></rect>
                <g clip-path="url(#truck-tank-clip)">
                  <rect x="22" y="19" width="72" height="25.5" fill="#F1F3EA"></rect>
                  <rect x="22" y="35.5" width="72" height="9" fill="#DDE2D2"></rect>
                  <rect
                    x="30"
                    y="22.3"
                    width="56"
                    height="2"
                    rx="1"
                    fill="#fff"
                    opacity="0.85"
                  ></rect>
                  <rect x="37" y="19" width="2.6" height="25.5" fill="#B9C1B0"></rect>
                  <rect x="76.4" y="19" width="2.6" height="25.5" fill="#B9C1B0"></rect>
                </g>
                <path
                  d="M57.8 26 C57.8 26 62 30.8 62 33.6 a4.2 4.2 0 0 1 -8.4 0 C53.6 30.8 57.8 26 57.8 26 Z"
                  fill="#6DB6E8"
                ></path>

                <path d={cabOutline} fill="#ACB63B"></path>
                <rect
                  x="100"
                  y="40"
                  width="34"
                  height="9"
                  fill="#97A233"
                  clip-path="url(#truck-cab-clip)"
                ></rect>
                <path d="M108.5 54.5 a9.5 9.5 0 0 1 19 0 Z" fill="#233026"></path>
                <path
                  d="M113.5 22 H124.6 q1.6 0 2.2 1.5 L130.2 31.9 q0.5 1.6 -1.1 1.6 H113.5 q-1.5 0 -1.5 -1.5 V23.5 q0 -1.5 1.5 -1.5 Z"
                  fill="#E3F0E6"
                ></path>
                <path
                  d="M116 31 l4.5 -6.5"
                  stroke="#fff"
                  stroke-width="1.2"
                  stroke-linecap="round"
                  opacity="0.7"
                ></path>
                <path d="M110.5 21 V45" stroke="#8A952B" stroke-width="0.7"></path>
                <rect x="112.5" y="36.6" width="3.6" height="1.2" rx="0.6" fill="#7F8A27"></rect>
                <rect x="131.6" y="41" width="2.4" height="3.4" rx="1" fill="#FFF1B8"></rect>
                <rect x="127" y="46.5" width="10" height="5" rx="1.6" fill="#2B3A2E"></rect>
                <path d="M130.4 25.5 h3.2" stroke="#2B3A2E" stroke-width="1"></path>
                <rect x="133" y="24" width="2.2" height="6" rx="1" fill="#2B3A2E"></rect>

                <circle
                  class="truck-beacon-glow"
                  cx="115.5"
                  cy="16"
                  r="5.5"
                  fill="#F4A93A"
                ></circle>
                <rect x="113" y="15.4" width="5" height="2.8" rx="1.2" fill="#F4A93A"></rect>
              </g>

              {wheelCentres.map((x) => (
                <g transform={`translate(${x} 54.5)`}>
                  <g class="truck-wheel">
                    <circle r="7.5" fill="#1C261E" />
                    <circle r="4.4" fill="#C5CDBB" />
                    <circle r="1.5" fill="#7C8A7C" />
                    {lugAngles.map((angle) => (
                      <circle cx="2.9" r="0.75" fill="#5C6B5E" transform={`rotate(${angle})`} />
                    ))}
                  </g>
                </g>
              ))}
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* The truck stops with its spray landing on the small tree, which is anchored
     to the right edge, hence the px offsets rather than percentages. */
  @keyframes drive {
    0% {
      left: -150px;
    }
    35%,
    55% {
      left: calc(100% - 188px);
    }
    100% {
      left: calc(100% + 10px);
    }
  }
  /* Same stops and easing as drive, so the wheels stand still with the truck. */
  @keyframes wheelRoll {
    0% {
      transform: rotate(0deg);
    }
    35%,
    55% {
      transform: rotate(2880deg);
    }
    100% {
      transform: rotate(4140deg);
    }
  }
  @keyframes truckNod {
    0%,
    27% {
      transform: rotate(0deg);
    }
    34% {
      transform: rotate(1.1deg);
    }
    37% {
      transform: rotate(-0.4deg);
    }
    39%,
    55% {
      transform: rotate(0deg);
    }
    59% {
      transform: rotate(-0.9deg);
    }
    65%,
    100% {
      transform: rotate(0deg);
    }
  }
  @keyframes waterWindow {
    0%,
    38% {
      opacity: 0;
    }
    41%,
    51% {
      opacity: 1;
    }
    54%,
    100% {
      opacity: 0;
    }
  }
  @keyframes waterFlow {
    to {
      stroke-dashoffset: -5.8;
    }
  }
  @keyframes puddleGrow {
    0%,
    39% {
      transform: scaleX(0.2);
    }
    48%,
    100% {
      transform: scaleX(1);
    }
  }
  @keyframes beaconPulse {
    0%,
    36%,
    55%,
    100% {
      opacity: 0;
    }
    38%,
    44%,
    50% {
      opacity: 0.45;
    }
    41%,
    47%,
    53% {
      opacity: 0.1;
    }
  }
  @keyframes cloudMove {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(400%);
    }
  }

  /* Positions live in classes rather than inline styles so the reduced-motion
     block below can override them without !important. */
  .cloud-slow {
    left: 0%;
    animation: cloudMove 20s linear infinite;
  }
  .cloud-fast {
    left: -20%;
    animation: cloudMove 25s linear infinite;
    animation-delay: -8s;
  }
  .watering-truck {
    left: -150px;
    animation: drive 10s ease-in-out infinite;
  }
  .truck-wheel {
    transform-box: fill-box;
    transform-origin: center;
    animation: wheelRoll 10s ease-in-out infinite;
  }
  .truck-body {
    transform-origin: 78px 58px;
    animation: truckNod 10s ease-in-out infinite;
  }
  .truck-water {
    animation: waterWindow 10s linear infinite;
  }
  .truck-stream {
    animation: waterFlow 0.45s linear infinite;
  }
  .truck-puddle {
    transform-box: fill-box;
    transform-origin: center;
    animation: puddleGrow 10s ease-out infinite;
  }
  .truck-beacon-glow {
    opacity: 0;
    animation: beaconPulse 10s linear infinite;
  }

  /* These three need a resting position, not just a stopped animation: the
     truck's base position lies outside the frame and the clouds would sit
     stacked at the left edge. The spray stays visible at rest. */
  @media (prefers-reduced-motion: reduce) {
    .cloud-slow {
      left: 60%;
      transform: none;
    }
    .cloud-fast {
      left: 20%;
      transform: none;
    }
    .watering-truck {
      left: calc(100% - 188px);
    }
  }
</style>
