---
import { Mail } from 'lucide-react'
import type { Language } from '../../i18n/languages'
import { getTranslations } from '../../i18n/t'

interface Props {
  language: Language
  spacingTop?: boolean
}

// Used by the contact page and the start page, so its keys live in the contact
// namespace rather than being maintained twice.
const { language, spacingTop = true } = Astro.props
const t = getTranslations(language, 'contact')
---

<section
  class:list={[
    'px-4 max-w-screen-lg mx-auto mb-20 md:px-6 lg:mb-28 xl:max-w-screen-xl xl:mb-36',
    spacingTop && 'mt-20 lg:mt-28 xl:mt-36',
  ]}
>
  <div class="inline-block mb-6 lg:mb-8">
    <span class="text-xs font-semibold tracking-widest text-green-light-900 uppercase">
      {t('cta.sectionLabel')}
    </span>
    <div class="h-0.5 w-12 bg-gradient-to-r from-green-light-900 to-transparent mt-1"></div>
  </div>

  <div class="relative bg-gradient-to-br from-green-dark-900 via-green-dark-900 to-green-middle-900 rounded-2xl lg:rounded-3xl p-6 md:p-10 lg:p-12 shadow-xl overflow-hidden">
    <div class="absolute top-0 right-0 w-96 h-96 bg-green-light-900/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
    <div class="absolute bottom-0 left-0 w-64 h-64 bg-green-middle-900/20 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>
    <div
      class="absolute inset-0 opacity-5"
      style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 24px 24px;"
    ></div>

    <div class="relative z-10 flex flex-col lg:flex-row lg:items-center lg:gap-12">
      <div class="flex-1 text-center lg:text-left">
        <h2 class="font-lato font-bold text-2xl mb-4 lg:text-3xl xl:text-4xl text-white">
          {t('cta.headline')}
        </h2>
        <p class="text-white/80 mb-8 max-w-xl lg:max-w-none leading-relaxed">
          {t('cta.description')}
        </p>

        <div>
          <a
            href="mailto:info@green-ecolution.de"
            aria-label={t('cta.mailAriaLabel')}
            class="group inline-flex items-center justify-center gap-x-3 rounded-xl font-semibold px-8 py-4 bg-white text-green-dark-900 transition-all duration-300 hover:bg-green-light-100 hover:shadow-lg hover:shadow-black/20 hover:scale-105 active:scale-100"
          >
            <Mail className="w-5 h-5 transition-transform group-hover:-rotate-12" />
            <span>{t('cta.mailButtonLabel')}</span>
          </a>
        </div>
      </div>

      <div class="hidden lg:block flex-shrink-0 w-80 h-40 xl:w-96 xl:h-48">
        <div class="relative w-full h-full overflow-hidden" aria-hidden="true">
          <div class="absolute top-2 cloud-slow">
            <svg class="w-12 h-6 opacity-30" viewBox="0 0 48 24">
              <ellipse cx="24" cy="14" rx="20" ry="10" fill="white"></ellipse>
              <ellipse cx="14" cy="12" rx="10" ry="8" fill="white"></ellipse>
              <ellipse cx="34" cy="12" rx="12" ry="8" fill="white"></ellipse>
            </svg>
          </div>
          <div class="absolute top-6 cloud-fast">
            <svg class="w-8 h-4 opacity-20" viewBox="0 0 48 24">
              <ellipse cx="24" cy="14" rx="18" ry="8" fill="white"></ellipse>
              <ellipse cx="16" cy="12" rx="8" ry="6" fill="white"></ellipse>
            </svg>
          </div>

          <div class="absolute bottom-4 left-0 right-0 h-1.5 bg-white/25 rounded-full"></div>
          <div class="absolute bottom-5 left-0 right-0 flex justify-around opacity-20">
            {Array.from({ length: 12 }).map(() => (
              <div class="w-0.5 h-2 bg-white/40 rounded-full" />
            ))}
          </div>

          <svg class="absolute bottom-4 right-4 w-16 h-28" viewBox="0 0 64 112">
            <rect x="28" y="70" width="8" height="38" fill="#6B4423" rx="2"></rect>
            <ellipse cx="32" cy="45" rx="26" ry="40" fill="#4C7741"></ellipse>
            <ellipse cx="32" cy="38" rx="18" ry="30" fill="#3D5F35"></ellipse>
          </svg>

          <svg class="absolute bottom-4 right-24 w-12 h-20" viewBox="0 0 64 80">
            <rect x="28" y="48" width="8" height="40" fill="#5D4E37" rx="2"></rect>
            <ellipse cx="32" cy="30" rx="22" ry="28" fill="#7B9F35"></ellipse>
            <ellipse cx="32" cy="26" rx="15" ry="20" fill="#6B8E4E"></ellipse>
          </svg>

          <svg class="absolute bottom-4 right-40 w-10 h-16 opacity-80" viewBox="0 0 64 96">
            <rect x="28" y="62" width="8" height="30" fill="#8B5A2B" rx="2"></rect>
            <ellipse cx="32" cy="48" rx="18" ry="28" fill="#ACB63B"></ellipse>
            <ellipse cx="32" cy="44" rx="12" ry="20" fill="#9AAF35"></ellipse>
          </svg>

          <div class="absolute bottom-2 watering-truck">
            <svg class="w-32 h-16" viewBox="0 0 128 64">
              <ellipse cx="64" cy="58" rx="52" ry="4" fill="rgba(0,0,0,0.15)"></ellipse>

              <rect x="10" y="18" width="58" height="28" rx="8" fill="#5B9BD5"></rect>
              <rect x="12" y="20" width="54" height="24" rx="6" fill="#7BB3E0"></rect>
              <rect x="16" y="26" width="46" height="12" rx="4" fill="#4A8BC2"></rect>

              <rect x="68" y="20" width="34" height="26" rx="4" fill="#E8E8E8"></rect>
              <rect x="82" y="24" width="16" height="12" rx="2" fill="#87CEEB"></rect>

              <circle cx="104" cy="38" r="3" fill="#FFD700"></circle>

              <g class="wheel wheel-rear">
                <circle cx="30" cy="52" r="9" fill="#333"></circle>
                <circle cx="30" cy="52" r="5" fill="#555"></circle>
                <circle cx="30" cy="52" r="2" fill="#777"></circle>
                <line x1="30" y1="45" x2="30" y2="59" stroke="#444" stroke-width="2"></line>
                <line x1="23" y1="52" x2="37" y2="52" stroke="#444" stroke-width="2"></line>
              </g>
              <g class="wheel wheel-front">
                <circle cx="88" cy="52" r="9" fill="#333"></circle>
                <circle cx="88" cy="52" r="5" fill="#555"></circle>
                <circle cx="88" cy="52" r="2" fill="#777"></circle>
                <line x1="88" y1="45" x2="88" y2="59" stroke="#444" stroke-width="2"></line>
                <line x1="81" y1="52" x2="95" y2="52" stroke="#444" stroke-width="2"></line>
              </g>

              <rect x="2" y="34" width="10" height="5" rx="2" fill="#666"></rect>

              <g class="water-drops">
                <ellipse cx="0" cy="42" rx="2.5" ry="4" fill="#5B9BD5"></ellipse>
                <ellipse cx="-5" cy="46" rx="2" ry="3" fill="#7BB3E0"></ellipse>
                <ellipse cx="3" cy="48" rx="2" ry="3" fill="#5B9BD5"></ellipse>
                <ellipse cx="-2" cy="44" rx="1.5" ry="2.5" fill="#7BB3E0"></ellipse>
              </g>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes drive {
    0% {
      left: -35%;
    }
    35%,
    55% {
      left: 50%;
    }
    100% {
      left: 110%;
    }
  }
  @keyframes waterSpray {
    0%,
    30% {
      opacity: 0;
      transform: scale(0.5);
    }
    40%,
    50% {
      opacity: 1;
      transform: scale(1);
    }
    60%,
    100% {
      opacity: 0;
      transform: scale(0.5);
    }
  }
  @keyframes cloudMove {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(400%);
    }
  }
  @keyframes wheelSpin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  /* Positions live in classes rather than inline styles so the reduced-motion
     block below can override them without !important. */
  .cloud-slow {
    left: 0%;
    animation: cloudMove 20s linear infinite;
  }
  .cloud-fast {
    left: -20%;
    animation: cloudMove 25s linear infinite;
    animation-delay: -8s;
  }
  .watering-truck {
    left: -30%;
    animation: drive 10s ease-in-out infinite;
  }
  .wheel {
    animation: wheelSpin 0.5s linear infinite;
  }
  .wheel-rear {
    transform-origin: 30px 52px;
  }
  .wheel-front {
    transform-origin: 88px 52px;
  }
  .water-drops {
    animation: waterSpray 10s ease-in-out infinite;
  }

  /* These four need a resting position, not just a stopped animation: drive ends
     at left 110% and cloudMove at translateX(400%), so freezing them on the end
     state would park them outside the frame. */
  @media (prefers-reduced-motion: reduce) {
    .cloud-slow {
      left: 60%;
      transform: none;
    }
    .cloud-fast {
      left: 20%;
      transform: none;
    }
    .watering-truck {
      left: 50%;
    }
    .water-drops {
      opacity: 1;
      transform: none;
    }
  }
</style>
