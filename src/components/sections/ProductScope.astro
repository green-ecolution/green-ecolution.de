---
import type { Language } from '../../i18n/languages'
import { getTranslations } from '../../i18n/t'
import { productScopeColumns } from '../../data/productScope'
import Arrow from '../icons/Arrow.astro'
import Button from '../Button.astro'

interface Props {
  language: Language
}

const { language } = Astro.props
const t = getTranslations(language, 'project')
---

<section
  id="produktumfang"
  class="px-4 max-w-208 mx-auto my-20 md:px-6 lg:my-28 lg:max-w-screen-lg xl:my-36 xl:max-w-screen-xl"
>
  <div class="mb-10 lg:mb-14">
    <div class="inline-block mb-4">
      <span class="text-xs font-semibold tracking-widest text-green-light-900 uppercase">
        {t('productScope.sectionLabel')}
      </span>
      <div class="h-0.5 w-12 bg-gradient-to-r from-green-light-900 to-transparent mt-1"></div>
    </div>

    <h2 class="font-lato font-bold text-2xl mb-4 text-grey-900 lg:text-3xl xl:text-4xl">
      {t('productScope.title')}
    </h2>

    <p class="text-grey-900/70 leading-relaxed max-w-2xl mb-4">
      {t('productScope.description')}
    </p>

    <p class="text-grey-900/60 leading-relaxed max-w-2xl">{t('productScope.framing')}</p>
  </div>

  <ul class="grid grid-cols-1 gap-4 md:grid-cols-3 lg:gap-5">
    {
      productScopeColumns.map((column) => {
        const Icon = column.icon

        return (
          <li class="h-full rounded-2xl border border-green-dark-900/10 bg-white p-5 lg:p-6">
            <span class="flex w-10 h-10 rounded-lg bg-green-light-900/15 items-center justify-center mb-4">
              <Icon className="w-5 h-5 text-green-dark-900" aria-hidden="true" />
            </span>
            <h3 class="font-lato font-semibold text-grey-900 mb-2">
              {t(`productScope.columns.${column.id}.label`)}
            </h3>
            <p class="text-grey-900/70 leading-relaxed">
              {t(`productScope.columns.${column.id}.description`)}
            </p>
          </li>
        )
      })
    }
  </ul>

  <div class="mt-8">
    <Button href={`/${language}/contact`} ariaLabel={t('productScope.ctaAriaLabel')} isDark>
      <span>{t('productScope.cta')}</span>
      <Arrow class="w-6 transition-all ease-in-out duration-300 group-hover:translate-x-2" />
    </Button>
  </div>
</section>
