---
import type { Language } from '../../i18n/languages'
import { getTranslations } from '../../i18n/t'
import { company } from '../../data/company'

interface Props {
  language: Language
}

// The year each paragraph tells of; the text itself names them.
const PARAGRAPHS = [
  { id: 'p1', year: 2024 },
  { id: 'p2', year: 2024 },
  { id: 'p3', year: 2025 },
  { id: 'p4', year: 2026 },
  { id: 'p5', year: 2026 },
] as const
const YEARS = [...new Set(PARAGRAPHS.map((paragraph) => paragraph.year))]
// One column per digit. A digit that differs between the years gets a strip
// with one entry per year, so only that digit rolls.
const DIGITS = [...String(YEARS[0])].map((_, position) => {
  const values = YEARS.map((year) => String(year)[position])
  return new Set(values).size === 1 ? values.slice(0, 1) : values
})

const { language } = Astro.props
const t = getTranslations(language, 'about')
---

<section class="px-4 max-w-208 mx-auto my-20 md:px-6 lg:my-28 lg:max-w-screen-lg xl:my-36">
  <div class="inline-block mb-4">
    <span class="text-xs font-semibold tracking-widest text-green-dark-900 uppercase">
      {t('story.sectionLabel')}
    </span>
    <div class="label-rule"></div>
  </div>

  <h2 class="font-lato font-bold text-2xl mb-8 text-grey-900 lg:text-3xl xl:text-4xl">
    {t('story.title')}
  </h2>

  <div data-story class="lg:grid lg:grid-cols-[minmax(0,42rem)_1fr] lg:gap-x-12">
    <div class="max-w-2xl space-y-4 text-grey-900/80 leading-relaxed lg:text-lg">
      {PARAGRAPHS.map((paragraph) => (
        <p data-story-part data-year-index={YEARS.indexOf(paragraph.year)}>
          {t(`story.${paragraph.id}`, { company: company.name })}
        </p>
      ))}
    </div>

    <div class="story-aside relative hidden lg:block" aria-hidden="true">
      <div class="story-year absolute right-0 top-0 flex font-lato font-bold tabular-nums text-green-dark-900/15">
        {DIGITS.map((values) => (
          <span class="story-digit">
            <span class:list={['story-strip', values.length > 1 && 'story-strip-rolling']}>
              {values.map((value) => (
                <span>{value}</span>
              ))}
            </span>
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* The year belongs to the paragraph being read, so it only shows once the
     script can tell which one that is. */
  .story-aside {
    opacity: 0;
    transition: opacity 0.4s ease-out;
  }

  [data-story][data-enhanced] .story-aside {
    opacity: 1;
  }

  .story-year {
    font-size: 5.5rem;
    line-height: 1;
    translate: 0 var(--year-y, 0);
    transition: translate 0.7s var(--ease-spring-settle);
  }

  .story-digit {
    display: block;
    height: 1em;
    overflow: hidden;
  }

  .story-strip {
    display: flex;
    flex-direction: column;
  }

  .story-strip > span {
    height: 1em;
  }

  .story-strip-rolling {
    translate: 0 calc(var(--year-index, 0) * -1em);
    transition: translate 0.7s var(--ease-spring-settle);
  }

  @media (prefers-reduced-motion: reduce) {
    .story-year,
    .story-strip-rolling {
      transition: none;
    }
  }
</style>

<script>
  import '../../scripts/storyYear'
</script>
