---
interface Props {
  label: string
  title: string
  description?: string
  wide?: boolean
}

const { label, title, description, wide = false } = Astro.props
---

<section
  class:list={[
    'px-4 max-w-208 mx-auto my-20 md:px-6 lg:my-28 xl:my-36',
    wide ? 'lg:max-w-screen-lg xl:max-w-screen-xl' : 'lg:max-w-screen-md',
  ]}
>
  <article class="mb-8 lg:mb-12 lg:text-center">
    <div class="inline-block mb-4 lg:mx-auto">
      <span class="text-xs font-semibold tracking-widest text-green-dark-900 uppercase">
        {label}
      </span>
      <div class="label-rule"></div>
    </div>
    <h2 class="font-lato font-bold text-2xl text-grey-900 lg:text-3xl">{title}</h2>
    {description && <p class="mt-6 text-grey-900/80 leading-relaxed">{description}</p>}
  </article>

  <slot />
</section>
