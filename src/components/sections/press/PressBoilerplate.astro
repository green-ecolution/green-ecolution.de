---
import { Copy } from 'lucide-react'
import PressSection from './PressSection.astro'
import ActionButton from '../../ActionButton.astro'
import type { Language } from '../../../i18n/languages'
import { getTranslations } from '../../../i18n/t'

interface Props {
  language: Language
}

const VARIANTS = ['short', 'medium', 'long'] as const

const { language } = Astro.props
const t = getTranslations(language, 'press')
---

<PressSection
  label={t('boilerplate.sectionLabel')}
  title={t('boilerplate.title')}
  description={t('boilerplate.description')}
>
  <ul class="space-y-6">
    {
      VARIANTS.map((variant) => {
        const label = t(`boilerplate.items.${variant}.label`)
        return (
          <li class="bg-green-light-100 border border-green-dark-900/20 rounded-2xl p-5 lg:p-6">
            <div class="flex items-start justify-between gap-4 mb-4">
              <h3 class="font-lato font-semibold text-lg text-grey-900">{label}</h3>
              <ActionButton
                data-copy={`boilerplate-${variant}`}
                data-copied-label={t('boilerplate.copied')}
                ariaLabel={t('boilerplate.copyAriaLabel', { variant: label })}
                class="flex-shrink-0"
              >
                <Copy className="w-4 h-4" aria-hidden="true" />
                <span data-copy-label>{t('boilerplate.copy')}</span>
              </ActionButton>
            </div>
            <p
              id={`boilerplate-${variant}`}
              class="text-grey-900/80 leading-relaxed whitespace-pre-line"
            >
              {t(`boilerplate.items.${variant}.text`)}
            </p>
          </li>
        )
      })
    }
  </ul>
</PressSection>

<script>
  import '../../../scripts/copyText'
</script>
