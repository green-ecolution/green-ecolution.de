---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import { ASSET_BASE_URL } from 'astro:env/server'
import { Download, FileArchive } from 'lucide-react'
import PressSection from './PressSection.astro'
import ActionButton from '../../ActionButton.astro'
import baumscheibePhoto from '../../../assets/photos/baumscheibe-bagger-tbz.jpg'
import wateringPhoto from '../../../assets/photos/bewaesserung-jungbaum-tbz.jpg'
import fieldPhoto from '../../../assets/photos/einsatz-jungbaum-tablet.jpg'
import sensorPhoto from '../../../assets/photos/sensor-einbau-erdbohrer.jpg'
import teamPhoto from '../../../assets/photos/team-progeek.jpg'
import type { Language } from '../../../i18n/languages'
import { getTranslations } from '../../../i18n/t'
import {
  formatDimensions,
  formatFileSize,
  IMAGE_ZIP_BYTES,
  IMAGE_ZIP_PATH,
  PRESS_IMAGES,
  pressAssetUrl,
  pressImagePath,
  type PressImageId,
} from '../../../lib/pressKit'

interface Props {
  language: Language
}

// Previews are downscaled copies, the downloads are the untouched originals.
// Swapping a photo means replacing both, or the page shows the wrong picture.
const PREVIEWS: Record<PressImageId, ImageMetadata> = {
  fieldWork: fieldPhoto,
  watering: wateringPhoto,
  sensorInstall: sensorPhoto,
  treePit: baumscheibePhoto,
  team: teamPhoto,
}

const { language } = Astro.props
const t = getTranslations(language, 'press')

const [lead, ...rest] = PRESS_IMAGES
---

<PressSection
  label={t('images.sectionLabel')}
  title={t('images.title')}
  description={t('images.description')}
  wide
>
  <figure
    class="overflow-hidden rounded-2xl border border-green-dark-900/20 lg:grid lg:grid-cols-12"
  >
    <Image
      src={PREVIEWS[lead.id]}
      alt={t(`images.items.${lead.id}.alt`)}
      widths={[640, 960, 1280]}
      sizes="(min-width: 1024px) 58vw, 100vw"
      loading="lazy"
      class="w-full aspect-[3/2] object-cover lg:col-span-7"
    />

    <figcaption
      class="flex flex-col bg-green-dark-900 p-6 text-white lg:col-span-5 lg:justify-center lg:p-8"
    >
      <h3 class="font-lato text-xl font-bold lg:text-2xl">
        {t(`images.items.${lead.id}.title`)}
      </h3>
      <p class="mt-3 text-white/90 leading-relaxed">
        {t(`images.items.${lead.id}.description`)}
      </p>
      <p class="mt-6 text-sm text-white/85 tabular-nums">
        {formatDimensions(lead)}
        <span class="block">
          {t('images.fileFacts', { size: formatFileSize(lead.bytes, language) })}
        </span>
      </p>
      <ActionButton
        href={pressAssetUrl(ASSET_BASE_URL, pressImagePath(lead))}
        download
        tone="onDark"
        ariaLabel={t('images.downloadAriaLabel', { image: t(`images.items.${lead.id}.title`) })}
        class="mt-6 self-start"
      >
        <Download className="w-4 h-4" aria-hidden="true" />
        {t('images.download')}
      </ActionButton>
    </figcaption>
  </figure>

  <ul class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:mt-6 lg:gap-6">
    {
      rest.map((image) => {
        const title = t(`images.items.${image.id}.title`)
        return (
          <li class="overflow-hidden rounded-2xl border border-green-dark-900/20">
            <figure class="flex h-full flex-col">
              <Image
                src={PREVIEWS[image.id]}
                alt={t(`images.items.${image.id}.alt`)}
                widths={[400, 640, 960, 1280]}
                sizes="(min-width: 640px) 48vw, 100vw"
                loading="lazy"
                class="w-full aspect-[3/2] object-cover"
              />

              <figcaption class="flex flex-1 flex-col bg-green-dark-900 p-5 text-white lg:p-6">
                <h3 class="font-lato text-lg font-semibold">{title}</h3>
                <p class="mt-2 text-sm text-white/90 leading-relaxed">
                  {t(`images.items.${image.id}.description`)}
                </p>
                <p class="mt-4 text-sm text-white/85 tabular-nums">
                  {formatDimensions(image)}
                  <span class="block">
                    {t('images.fileFacts', { size: formatFileSize(image.bytes, language) })}
                  </span>
                </p>
                <div class="mt-auto pt-5">
                  <ActionButton
                    href={pressAssetUrl(ASSET_BASE_URL, pressImagePath(image))}
                    download
                    tone="onDark"
                    ariaLabel={t('images.downloadAriaLabel', { image: title })}
                  >
                    <Download className="w-4 h-4" aria-hidden="true" />
                    {t('images.download')}
                  </ActionButton>
                </div>
              </figcaption>
            </figure>
          </li>
        )
      })
    }
  </ul>

  <a
    href={pressAssetUrl(ASSET_BASE_URL, IMAGE_ZIP_PATH)}
    download
    aria-label={t('images.zip.ariaLabel')}
    class="press-spring group mt-4 flex items-center gap-4 rounded-2xl border border-green-dark-900/20 bg-green-light-100 p-5 hover:-translate-y-1 hover:shadow-sm lg:mt-6 lg:p-6"
  >
    <span
      class="flex-shrink-0 w-12 h-12 rounded-xl bg-green-dark-900/10 flex items-center justify-center transition-colors group-hover:bg-green-dark-900"
    >
      <FileArchive
        className="w-6 h-6 text-green-dark-900 transition-colors group-hover:text-white"
      />
    </span>
    <span class="min-w-0">
      <span
        class="block font-lato font-semibold text-lg text-grey-900 group-hover:text-green-dark-900 transition-colors"
      >
        {t('images.zip.label')}
      </span>
      <span class="block text-sm text-grey-900/70">
        {t('images.zip.description', { size: formatFileSize(IMAGE_ZIP_BYTES, language) })}
      </span>
    </span>
  </a>

  <div
    class="mt-10 rounded-2xl border border-green-dark-900/20 bg-green-light-100 p-6 lg:mt-12 lg:p-8"
  >
    <h3 class="font-lato font-semibold text-lg text-grey-900">{t('images.usage.title')}</h3>
    <p class="mt-4 text-grey-900/80 leading-relaxed">{t('images.usage.text')}</p>
  </div>
</PressSection>
