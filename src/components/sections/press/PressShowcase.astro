---
import { MonitorPlay, ArrowUpRight } from 'lucide-react'
import type { Language } from '../../../i18n/languages'
import { getTranslations } from '../../../i18n/t'

interface Props {
  language: Language
}

const { language } = Astro.props
const t = getTranslations(language, 'press')
---

<!-- The loop fills whatever screen it runs on, but its scenes are laid out for a
     screen at arm's length, not for a phone. Below md it stays out of sight. -->
<section class="hidden px-4 max-w-208 mx-auto my-20 md:block md:px-6 lg:my-28 lg:max-w-screen-md xl:my-36">
  <a
    href={`/${language}/showcase`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={t('showcase.buttonAriaLabel')}
    class="press-spring group flex flex-col gap-6 rounded-2xl bg-green-dark-900 p-6 text-white hover:-translate-y-1 hover:shadow-lg hover:shadow-green-dark-900/20 sm:flex-row sm:items-center sm:justify-between lg:p-8"
  >
    <span class="flex gap-4 min-w-0">
      <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-white/10 flex items-center justify-center transition-colors group-hover:bg-white">
        <MonitorPlay className="w-6 h-6 text-white transition-colors group-hover:text-green-dark-900" />
      </span>
      <span class="min-w-0">
        <span class="block text-xs font-bold tracking-widest text-white uppercase">
          {t('showcase.sectionLabel')}
        </span>
        <span class="mt-1 block font-lato font-semibold text-lg">{t('showcase.title')}</span>
        <span class="mt-2 block text-sm text-white/70 leading-relaxed">
          {t('showcase.description')}
        </span>
      </span>
    </span>

    <span class="flex-shrink-0 self-start inline-flex items-center gap-2 rounded-xl bg-white px-5 py-2.5 font-semibold text-green-dark-900 transition-colors duration-300 group-hover:bg-green-light-900 group-hover:text-grey-900 sm:self-auto">
      {t('showcase.buttonLabel')}
      <ArrowUpRight className="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
    </span>
  </a>
</section>
