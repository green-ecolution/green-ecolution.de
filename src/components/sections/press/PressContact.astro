---
import { Mail } from 'lucide-react'
import PressSection from './PressSection.astro'
import ActionButton from '../../ActionButton.astro'
import type { Language } from '../../../i18n/languages'
import { getTranslations } from '../../../i18n/t'

interface Props {
  language: Language
}

const PRESS_EMAIL = 'info@green-ecolution.de'

const { language } = Astro.props
const t = getTranslations(language, 'press')
---

<PressSection
  label={t('contact.sectionLabel')}
  title={t('contact.title')}
  description={t('contact.description')}
>
  <div
    class="bg-green-light-100 border border-green-dark-900/20 rounded-2xl p-6 lg:p-8 flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="flex items-center gap-4 min-w-0">
      <span
        class="flex-shrink-0 w-12 h-12 rounded-xl bg-green-dark-900/10 flex items-center justify-center"
      >
        <Mail className="w-6 h-6 text-green-dark-900" />
      </span>
      <div class="min-w-0">
        <p class="text-xs font-semibold tracking-widest text-green-light-900 uppercase">
          {t('contact.emailLabel')}
        </p>
        <p class="font-lato font-semibold text-lg text-grey-900 truncate">{PRESS_EMAIL}</p>
      </div>
    </div>

    <ActionButton
      href={`mailto:${PRESS_EMAIL}`}
      tone="solid"
      size="md"
      ariaLabel={t('contact.buttonAriaLabel')}
      class="flex-shrink-0 hover:shadow-lg hover:shadow-green-light-900/40 hover:-translate-y-0.5"
    >
      {t('contact.buttonLabel')}
    </ActionButton>
  </div>
</PressSection>
