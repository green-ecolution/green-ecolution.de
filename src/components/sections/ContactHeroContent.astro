---
import { Mail, ExternalLink, ArrowRight, Phone, MessageCircle, CalendarDays } from 'lucide-react'
import type { Language } from '../../i18n/languages'
import { getTranslations } from '../../i18n/t'
import { company } from '../../data/company'

interface Props {
  language: Language
}

const { language } = Astro.props
const t = getTranslations(language, 'contact')

const channels = [
  {
    href: `mailto:${company.email}`,
    icon: Mail,
    label: t('channels.mail.label'),
    value: company.email,
    isExternal: false,
  },
  {
    href: company.mobile.href,
    icon: Phone,
    label: t('channels.phone.label'),
    value: company.mobile.display,
    isExternal: false,
  },
  {
    href: company.booking.overviewUrl,
    icon: CalendarDays,
    label: t('channels.booking.label'),
    value: t('channels.booking.cta'),
    isExternal: true,
  },
  {
    href: company.whatsappUrl,
    icon: MessageCircle,
    label: t('channels.whatsapp.label'),
    value: t('channels.whatsapp.cta'),
    isExternal: true,
  },
  {
    href: company.githubUrl,
    icon: null,
    label: t('channels.github.label'),
    value: company.githubUrl.replace('https://', ''),
    isExternal: true,
  },
]
---

<div class="mt-12 lg:mt-16 max-w-4xl mx-auto text-left">
  <div class="relative overflow-hidden rounded-3xl border border-green-dark-900/10 bg-gradient-to-br from-green-light-100 via-white to-white p-6 md:p-10">
    <div
      class="absolute -top-24 -left-24 w-72 h-72 rounded-full bg-green-light-900/15 blur-3xl pointer-events-none"
      aria-hidden="true"
    ></div>

    <div class="relative grid gap-8 md:grid-cols-5 md:gap-10 md:items-center">
      <div class="md:col-span-2">
        <div class="inline-flex items-center gap-2 mb-4">
          <span
            class="w-2 h-2 bg-green-light-900 rounded-full animate-pulse"
            aria-hidden="true"
          ></span>
          <span class="text-xs font-semibold text-green-dark-900 tracking-wide uppercase">
            {t('channels.badge')}
          </span>
        </div>
        <h2 class="font-lato font-bold text-2xl text-grey-900 mb-3 lg:text-3xl">
          {t('channels.title')}
        </h2>
        <p class="text-grey-900/70 leading-relaxed">{t('channels.description')}</p>
      </div>

      <ul class="md:col-span-3 divide-y divide-green-dark-900/10">
        {channels.map((channel) => (
          <li>
            <a
              href={channel.href}
              target={channel.isExternal ? '_blank' : undefined}
              rel={channel.isExternal ? 'noopener noreferrer' : undefined}
              class="group -mx-3 flex items-center gap-4 rounded-2xl px-3 py-3.5 transition-colors hover:bg-green-dark-900/5 focus-visible:outline-2 focus-visible:outline-green-dark-900"
            >
              <span
                class="w-11 h-11 shrink-0 rounded-xl bg-green-dark-900/10 text-green-dark-900 flex items-center justify-center transition-colors group-hover:bg-green-dark-900 group-hover:text-white"
                aria-hidden="true"
              >
                {channel.icon ? (
                  <channel.icon className="w-5 h-5" />
                ) : (
                  <span class="github-icon w-5 h-5 bg-current" />
                )}
              </span>

              <span class="min-w-0 flex-grow">
                <span class="block text-xs font-semibold tracking-wide text-grey-900/60 uppercase">
                  {channel.label}
                </span>
                <span class="block text-sm font-semibold text-grey-900 break-words sm:text-base">
                  {channel.value}
                </span>
              </span>

              {channel.isExternal ? (
                <ExternalLink className="w-4 h-4 shrink-0 text-green-dark-900/60 transition-colors group-hover:text-green-dark-900" />
              ) : (
                <ArrowRight className="w-4 h-4 shrink-0 text-green-dark-900/60 transition-all group-hover:translate-x-1 group-hover:text-green-dark-900" />
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>

<style>
  /* Masking lets the brand SVG follow currentColor on hover. */
  .github-icon {
    mask: url('/assets/svg/socials/github.svg') center / contain no-repeat;
  }
</style>
