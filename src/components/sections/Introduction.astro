---
import IntroductionSlider from '../islands/IntroductionSlider'
import type { IntroductionFact } from '../islands/IntroductionSlider'
import type { Language } from '../../i18n/languages'
import { getTranslations } from '../../i18n/t'

interface Props {
  language: Language
}

const FACTS = [
  { id: 'sensor', icon: '/assets/svg/general/sensor.svg' },
  { id: 'evaluation', icon: '/assets/svg/general/statistics.svg' },
  { id: 'youngTrees', icon: '/assets/svg/general/tree.svg' },
  { id: 'monitoring', icon: '/assets/svg/general/location.svg' },
] as const

const { language } = Astro.props
const t = getTranslations(language, 'home')
const tc = getTranslations(language, 'common')

const facts: IntroductionFact[] = FACTS.map((fact) => ({
  id: fact.id,
  icon: fact.icon,
  label: t(`introduction.facts.${fact.id}.label`),
  description: t(`introduction.facts.${fact.id}.description`),
}))

// %s is splide's own placeholder syntax, not the catalog's, and stays literal.
const sliderTranslations = {
  prev: tc('slider.prev'),
  next: tc('slider.next'),
  first: tc('slider.first'),
  last: tc('slider.last'),
  slideX: tc('slider.slideX'),
  pageX: tc('slider.pageX'),
  carousel: tc('slider.carousel'),
  select: tc('slider.select'),
  slide: tc('slider.slide'),
  slideLabel: tc('slider.slideLabel'),
}
---

<section class="max-w-208 mx-auto mt-20 mb-20 md:mt-24 lg:mt-16 lg:mb-0 lg:max-w-screen-lg lg:grid lg:grid-cols-[1fr_1.5fr] lg:gap-x-10 lg:items-center xl:grid-cols-2 xl:max-w-screen-xl">
  <article class="px-4 mb-8 md:px-6 lg:mb-14">
    <div class="mb-6 lg:mb-8">
      <div class="inline-block">
        <span class="text-xs font-semibold tracking-widest text-green-light-900 uppercase">
          {t('introduction.sectionLabel')}
        </span>
        <div class="h-0.5 w-12 bg-gradient-to-r from-green-light-900 to-transparent mt-1"></div>
      </div>
    </div>

    <h2 class="font-lato font-bold text-2xl mb-6 text-grey-900 lg:text-3xl">
      {t('introduction.title')}
    </h2>
    <p class="text-grey-900/80 leading-relaxed">{t('introduction.description')}</p>
  </article>

  <div>
    <IntroductionSlider
      client:visible
      facts={facts}
      ariaLabel={t('introduction.sliderAriaLabel')}
      sliderTranslations={sliderTranslations}
    />
  </div>
</section>
