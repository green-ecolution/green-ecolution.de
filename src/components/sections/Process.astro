---
import type { Language } from '../../i18n/languages'
import { getTranslations } from '../../i18n/t'
import { workflowSteps } from '../../data/workflowSteps'

interface Props {
  language: Language
}

const { language } = Astro.props
const t = getTranslations(language, 'project')
---

<section
  id="process"
  class="max-w-208 mx-auto my-20 px-4 md:px-6 lg:my-28 lg:max-w-screen-lg xl:my-36 xl:max-w-screen-xl"
>
  <div class="mb-10 lg:mb-16">
    <div class="inline-block mb-6">
      <span class="text-xs font-semibold tracking-widest text-green-light-900 uppercase">
        {t('process.sectionLabel')}
      </span>
      <div class="h-0.5 w-12 bg-gradient-to-r from-green-light-900 to-transparent mt-1"></div>
    </div>

    <div class="lg:flex lg:justify-between lg:gap-12 xl:gap-16">
      <h2
        class="font-lato font-bold text-2xl text-grey-900 mb-4 lg:mb-0 lg:max-w-xs lg:shrink-0 lg:text-3xl xl:max-w-sm xl:text-4xl"
      >
        {t('process.title')}
      </h2>

      <p class="text-grey-900/70 leading-relaxed lg:max-w-2xl">{t('process.description')}</p>
    </div>
  </div>

  <div class="space-y-12 lg:space-y-0">
    {
      workflowSteps.map((step, index) => {
        const Icon = step.icon
        // 'as const' keeps the numbers literal so the template resolves to real
        // catalog keys instead of widening to string.
        const details = ([1, 2, 3, 4] as const).map((n) =>
          t(`process.steps.${step.id}.details.item${n}`),
        )
        const isEven = index % 2 === 0

        return (
          <div
            class:list={[
              'lg:grid lg:grid-cols-2 lg:gap-12 xl:gap-16 lg:items-start',
              !isEven && 'lg:direction-rtl',
              index > 0 && 'lg:pt-12 lg:border-t lg:border-grey-900/10',
            ]}
          >
            <div class:list={['mb-8 lg:mb-0', !isEven && 'lg:order-2 lg:text-left']}>
              <div class="flex items-center gap-3 mb-4">
                <Icon className="w-6 h-6 text-green-dark-900/50" />
                <span class="text-xs font-semibold tracking-widest uppercase text-green-dark-900/60">
                  {step.number} · {t(`process.steps.${step.id}.category`)}
                </span>
              </div>

              <h3 class="font-lato font-bold text-2xl text-grey-900 mb-3 lg:text-3xl">
                {t(`process.steps.${step.id}.title`)}
              </h3>

              <p class="text-grey-900/70 leading-relaxed mb-6 lg:text-lg">
                {t(`process.steps.${step.id}.description`)}
              </p>
            </div>

            <div class:list={[!isEven && 'lg:order-1']}>
              <div class="bg-green-light-100/50 rounded-2xl p-5 md:p-6 lg:p-8">
                <ul class="space-y-3">
                  {details.map((detail) => (
                    <li class="flex items-start gap-3">
                      <div class="w-1.5 h-1.5 rounded-full bg-green-dark-900/40 mt-2 flex-shrink-0" />
                      <span class="text-sm text-grey-900/70 leading-relaxed">{detail}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        )
      })
    }
  </div>
</section>
