---
import type { Language } from '../../i18n/languages'
import { getTranslations } from '../../i18n/t'
import { sensorSpecs, sensorFeatures } from '../../data/sensorSpecs'
import { Image } from 'astro:assets'
import { Check } from 'lucide-react'
import sensorPhoto from '../../assets/photos/sensor-einbau-erdbohrer.jpg'
import setupPhoto from '../../assets/photos/sensor-einrichtung-app-qr.jpg'
import probePoster from '../../assets/illustrations/soil-probe-poster.png'
import SoilProbeIsland from '../islands/probe/SoilProbeIsland'
import { reachedPoints, soakLevel } from '../../lib/soakLevel'

interface Props {
  language: Language
}

const { language } = Astro.props
const t = getTranslations(language, 'home')

const depths = [
  { y: 120, color: '#658A58', zone: t('sensorProbe.zones.fineRoots') },
  { y: 200, color: '#4C7741', zone: t('sensorProbe.zones.mainRoots') },
  { y: 280, color: '#3D5F35', zone: t('sensorProbe.zones.deepRoots') },
]

const START_LEVEL = soakLevel(0)
const START_REACHED = reachedPoints(START_LEVEL)
const CHAPTER_LABELS = [
  t('sensorProbe.sectionLabel'),
  t('sensorProbe.installation.sectionLabel'),
  t('sensorSetup.sectionLabel'),
]
const SETUP_STEPS = ['scan', 'assign', 'done'] as const

const FINE_ROOTS = [
  { d: 'M160,75 Q130,90 100,100 Q80,105 65,95', width: '1.5' },
  { d: 'M160,75 Q180,85 210,95 Q230,100 250,92', width: '1.5' },
  { d: 'M160,78 Q140,95 115,108 Q100,115 85,108', width: '1' },
  { d: 'M160,78 Q175,92 200,105 Q220,112 240,105', width: '1' },
]
const MEDIUM_ROOTS = [
  'M160,100 Q135,140 110,170 Q95,185 80,178',
  'M160,100 Q185,145 205,175 Q218,188 235,180',
]
const DEEP_ROOTS = [
  'M158,120 Q140,190 125,250 Q118,270 110,260',
  'M162,120 Q178,195 190,255 Q196,272 205,262',
]
---

<section data-pin-section class="my-20 lg:my-28 xl:my-36">
  <div class="px-4 max-w-208 mx-auto md:px-6 lg:max-w-screen-lg xl:max-w-screen-xl">
    <div data-pin-track>
      <div data-pin-stage>
        <div data-hardware class="hardware-chapters">
          <article
            data-chapter="0"
            data-active="true"
            class="hardware-chapter lg:grid lg:grid-cols-2 lg:gap-x-12 xl:gap-x-16 lg:items-center"
          >
            <div class="mb-10 lg:mb-0">
              <div
                data-soak-root
                data-soak-status-shower={t('sensorProbe.soak.shower.status')}
                data-soak-status-midway={t('sensorProbe.soak.midway.status')}
                data-soak-status-soak={t('sensorProbe.soak.soak.status')}
                style={`--soak-level: ${START_LEVEL}`}
                class="relative bg-gradient-to-b from-green-light-100/60 to-white rounded-2xl p-4 lg:p-6 border border-green-dark-900/5 shadow-sm"
              >
                <div class="probe-model relative w-full max-w-sm mx-auto aspect-[8/9]">
                  <Image
                    src={probePoster}
                    alt=""
                    widths={[384, 768]}
                    sizes="(min-width: 640px) 24rem, calc(100vw - 4rem)"
                    loading="lazy"
                    class="probe-poster absolute inset-0 w-full h-full"
                  />
                  <svg
                    viewBox="0 0 320 360"
                    class="probe-sketch w-full h-full"
                    aria-label={t('sensorProbe.illustrationAriaLabel')}
                    role="img"
                  >
                    <rect x="0" y="0" width="320" height="60" fill="#f0f7ed" rx="8"></rect>

                    <rect
                      x="0"
                      y="60"
                      width="320"
                      height="300"
                      fill="#8B7355"
                      opacity="0.15"
                    ></rect>
                    <rect x="0" y="60" width="320" height="4" fill="#ACB63B" opacity="0.4"></rect>

                    <rect
                      x="0"
                      y="64"
                      width="320"
                      height="100"
                      fill="#8B7355"
                      opacity="0.08"
                    ></rect>
                    <rect
                      x="0"
                      y="164"
                      width="320"
                      height="100"
                      fill="#8B7355"
                      opacity="0.14"
                    ></rect>
                    <rect x="0" y="264" width="320" height="96" fill="#8B7355" opacity="0.2"></rect>

                    <defs>
                      <linearGradient id="soak-front" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#3B6E8F" stop-opacity="0.3"></stop>
                        <stop offset="0.85" stop-color="#3B6E8F" stop-opacity="0.22"></stop>
                        <stop offset="1" stop-color="#3B6E8F" stop-opacity="0"></stop>
                      </linearGradient>
                    </defs>
                    <rect
                      class="soak-water"
                      x="0"
                      y="64"
                      width="320"
                      height="250"
                      fill="url(#soak-front)"
                    ></rect>

                    <g opacity="0.18">
                      {FINE_ROOTS.map((root) => (
                        <path d={root.d} fill="none" stroke="#6B4423" stroke-width={root.width} />
                      ))}
                    </g>
                    <g opacity="0.13">
                      {MEDIUM_ROOTS.map((d) => (
                        <path d={d} fill="none" stroke="#6B4423" stroke-width="1.8" />
                      ))}
                    </g>
                    <g opacity="0.09">
                      {DEEP_ROOTS.map((d) => (
                        <path d={d} fill="none" stroke="#6B4423" stroke-width="2" />
                      ))}
                    </g>

                    {depths.map((depth) => (
                      <g>
                        <line
                          x1="40"
                          y1={depth.y}
                          x2="280"
                          y2={depth.y}
                          stroke="#8B7355"
                          stroke-width="0.5"
                          stroke-dasharray="6 4"
                          opacity="0.3"
                        />
                        <text
                          x="40"
                          y={depth.y - 6}
                          text-anchor="start"
                          fill={depth.color}
                          font-size="13"
                          style="font-family: var(--font-lato)"
                          font-weight="600"
                        >
                          {depth.zone}
                        </text>
                      </g>
                    ))}

                    <rect
                      x="155"
                      y="40"
                      width="10"
                      height="260"
                      fill="#4C7741"
                      rx="3"
                      opacity="0.9"
                    ></rect>
                    <rect
                      x="157"
                      y="40"
                      width="6"
                      height="260"
                      fill="#658A58"
                      rx="2"
                      opacity="0.5"
                    ></rect>

                    <rect x="148" y="32" width="24" height="30" fill="#3D5F35" rx="6"></rect>
                    <rect
                      x="153"
                      y="36"
                      width="14"
                      height="4"
                      fill="#ACB63B"
                      rx="2"
                      opacity="0.7"
                    ></rect>

                    {depths.map((depth, index) => (
                      <g class="soak-point" data-reached={index < START_REACHED ? '' : undefined}>
                        <circle
                          class="soak-ring"
                          cx="160"
                          cy={depth.y}
                          r="15"
                          fill="none"
                          stroke="#3B6E8F"
                          stroke-width="2.5"
                        />
                        <circle cx="160" cy={depth.y} r="12" fill={depth.color} opacity="0.2" />
                        <circle cx="160" cy={depth.y} r="7" fill={depth.color} />
                        <circle cx="160" cy={depth.y} r="3" fill="white" opacity="0.6" />

                        {[
                          { r: '2.5', values: '0;0.8;0.8;0', begin: index * 0.8 },
                          { r: '2', values: '0;0.6;0.6;0', begin: index * 0.8 + 1.5 },
                        ].map((particle) => (
                          <circle r={particle.r} fill="#ACB63B" opacity="0" class="motion-only">
                            <animateMotion
                              path={`M160,${depth.y} L160,40`}
                              dur="3s"
                              begin={`${particle.begin}s`}
                              repeatCount="indefinite"
                            />
                            <animate
                              attributeName="opacity"
                              values={particle.values}
                              dur="3s"
                              begin={`${particle.begin}s`}
                              repeatCount="indefinite"
                            />
                          </circle>
                        ))}
                      </g>
                    ))}

                    <rect x="157" y="12" width="6" height="22" fill="#6B4423" rx="2"></rect>
                    <ellipse cx="160" cy="6" rx="18" ry="12" fill="#4C7741" opacity="0.7"></ellipse>
                    <ellipse cx="160" cy="3" rx="12" ry="8" fill="#3D5F35" opacity="0.5"></ellipse>

                    <g opacity="0.4" class="motion-only">
                      <path
                        d="M178,28 Q188,20 178,12"
                        fill="none"
                        stroke="#ACB63B"
                        stroke-width="1.5"
                        stroke-linecap="round"
                      >
                        <animate
                          attributeName="opacity"
                          values="0;0.6;0"
                          dur="2s"
                          repeatCount="indefinite"
                        ></animate>
                      </path>
                      <path
                        d="M184,32 Q198,20 184,8"
                        fill="none"
                        stroke="#ACB63B"
                        stroke-width="1.5"
                        stroke-linecap="round"
                      >
                        <animate
                          attributeName="opacity"
                          values="0;0.4;0"
                          dur="2s"
                          begin="0.4s"
                          repeatCount="indefinite"
                        ></animate>
                      </path>
                    </g>
                  </svg>
                  <SoilProbeIsland
                    client:visible={{ rootMargin: '600px' }}
                    zones={depths.map((depth) => depth.zone)}
                  />
                </div>

                <div class="mt-4 border-t border-green-dark-900/10 pt-4">
                  <p class="font-lato font-semibold text-sm text-grey-900">
                    {t('sensorProbe.soak.title')}
                  </p>
                  <p
                    data-soak-text
                    aria-live="polite"
                    class="mt-1 text-sm text-grey-900/70 leading-relaxed min-h-[3lh]"
                  >
                    {t('sensorProbe.soak.shower.status')}
                  </p>
                </div>
              </div>
            </div>

            <div>
              <div class="inline-block mb-6">
                <span class="text-xs font-semibold tracking-widest text-green-dark-900 uppercase">
                  {t('sensorProbe.sectionLabel')}
                </span>
                <div class="label-rule"></div>
              </div>

              <h2 class="font-lato font-bold text-2xl mb-4 text-grey-900 lg:text-3xl xl:text-4xl">
                {t('sensorProbe.title')}
              </h2>

              <p class="text-grey-900/70 leading-relaxed">{t('sensorProbe.description')}</p>

              <ul class="space-y-4 mt-6">
                {sensorFeatures.map((feature) => {
                  const Icon = feature.icon

                  return (
                    <li class="flex items-start gap-4">
                      <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-green-light-900/15 flex items-center justify-center">
                        <Icon className="w-5 h-5 text-green-dark-900" />
                      </div>
                      <div>
                        <h3 class="font-lato font-semibold text-grey-900 mb-0.5">
                          {t(`sensorProbe.features.${feature.id}.label`)}
                        </h3>
                        <p class="text-sm text-grey-900/70 leading-relaxed">
                          {t(`sensorProbe.features.${feature.id}.description`)}
                        </p>
                      </div>
                    </li>
                  )
                })}
              </ul>

              <div class="mt-6 border-t border-green-dark-900/10 pt-5">
                <p class="mb-2 text-xs font-semibold tracking-widest uppercase text-green-dark-900">
                  {t('sensorProbe.readings.title')}
                </p>
                <ul>
                  {depths.map((depth, index) => (
                    <li
                      data-soak-reading
                      data-reached={index < START_REACHED ? '' : undefined}
                      class="reading flex items-center justify-between gap-4 border-b border-green-dark-900/10 py-2 last:border-b-0"
                    >
                      <span class="font-lato font-semibold text-sm text-grey-900">
                        {depth.zone}
                      </span>
                      <span class="reading-pill inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-semibold">
                        <span class="reading-dot h-1.5 w-1.5 rounded-full"></span>
                        <span class="reading-dry">{t('sensorProbe.readings.dry')}</span>
                        <span class="reading-moist">{t('sensorProbe.readings.moist')}</span>
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </article>

          <article
            data-chapter="1"
            data-active="false"
            class="hardware-chapter lg:grid lg:grid-cols-12 lg:gap-x-12 xl:gap-x-16 lg:items-center"
          >
            <figure class="mb-10 lg:mb-0 lg:col-span-7">
              <Image
                src={sensorPhoto}
                alt={t('sensorProbe.photoAlt')}
                widths={[640, 960, 1280, 1600]}
                sizes="(min-width: 1280px) 692px, (min-width: 1024px) 56vw, 100vw"
                loading="lazy"
                class="w-full aspect-[4/3] object-cover rounded-2xl"
              />
              <figcaption class="mt-3 text-sm text-grey-900/60">
                {t('sensorProbe.photoCaption')}
              </figcaption>
            </figure>

            <div class="lg:col-span-5">
              <div class="inline-block mb-6">
                <span class="text-xs font-semibold tracking-widest text-green-dark-900 uppercase">
                  {t('sensorProbe.installation.sectionLabel')}
                </span>
                <div class="label-rule"></div>
              </div>
              <h3 class="font-lato font-bold text-2xl mb-4 text-grey-900 lg:text-3xl xl:text-4xl">
                {t('sensorProbe.installation.title')}
              </h3>

              <p class="text-grey-900/70 leading-relaxed mb-4">
                {t('sensorProbe.installation.text')}
              </p>

              <p class="text-grey-900/70 leading-relaxed mb-6">{t('sensorProbe.availability')}</p>

              <ul class="flex flex-wrap gap-3">
                {sensorSpecs.map((spec) => (
                  <li
                    data-reveal-item
                    class="spec-pill flex items-center gap-2 border border-green-light-900/40 rounded-full px-4 py-2"
                  >
                    <span class="font-lato font-bold text-green-dark-900">
                      {t(`sensorProbe.specs.${spec}.value`)}
                    </span>
                    <span class="text-sm text-grey-900/70">
                      {t(`sensorProbe.specs.${spec}.label`)}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </article>

          <article
            data-chapter="2"
            data-active="false"
            class="hardware-chapter lg:grid lg:grid-cols-12 lg:gap-x-12 xl:gap-x-16 lg:items-center"
          >
            <figure class="mb-10 lg:mb-0 lg:col-span-7">
              <div class="relative overflow-hidden rounded-2xl">
                <Image
                  src={setupPhoto}
                  alt={t('sensorSetup.photoAlt')}
                  widths={[640, 960, 1280, 1600]}
                  sizes="(min-width: 1280px) 692px, (min-width: 1024px) 56vw, 100vw"
                  loading="lazy"
                  class="w-full aspect-[4/3] object-cover"
                />
                <span class="scan-frame" aria-hidden="true"></span>
                <span class="setup-connected absolute left-3 bottom-3 inline-flex items-center gap-1.5 rounded-full bg-white/95 py-1 pl-2 pr-3 text-xs font-semibold text-green-dark-900 shadow-sm">
                  <span class="flex h-4 w-4 items-center justify-center rounded-full bg-green-dark-900 text-white">
                    <Check aria-hidden="true" className="h-3 w-3" />
                  </span>
                  {t('sensorSetup.connected')}
                </span>
              </div>
              <figcaption class="mt-3 text-sm text-grey-900/60">
                {t('sensorSetup.photoCaption')}
              </figcaption>
            </figure>

            <div class="lg:col-span-5">
              <div class="inline-block mb-6">
                <span class="text-xs font-semibold tracking-widest text-green-dark-900 uppercase">
                  {t('sensorSetup.sectionLabel')}
                </span>
                <div class="label-rule"></div>
              </div>
              <h3 class="font-lato font-bold text-2xl mb-4 text-grey-900 lg:text-3xl xl:text-4xl">
                {t('sensorSetup.title')}
              </h3>

              <p class="text-grey-900/70 leading-relaxed mb-5">{t('sensorSetup.description')}</p>

              <ol class="mb-5 space-y-2">
                {SETUP_STEPS.map((step) => (
                  <li data-reveal-item class="setup-step flex items-center gap-3">
                    <span class="setup-check flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-green-dark-900 bg-green-dark-900 text-white">
                      <Check aria-hidden="true" className="h-3.5 w-3.5" />
                    </span>
                    <span class="setup-label font-lato font-semibold text-grey-900">
                      {t(`sensorSetup.steps.${step}`)}
                    </span>
                  </li>
                ))}
              </ol>

              <p class="text-grey-900/70 leading-relaxed">{t('sensorProbe.probeCarrier')}</p>
            </div>
          </article>
        </div>

        <div
          class="hardware-progress mt-3 gap-4"
          role="group"
          aria-label={t('sensorProbe.chaptersLabel')}
        >
          {CHAPTER_LABELS.map((label, index) => (
            <button
              type="button"
              data-chapter-marker={index}
              data-active={String(index === 0)}
              class="group/marker w-28 cursor-pointer rounded-sm py-3 text-left"
            >
              <span class="block h-1 overflow-hidden rounded-full bg-green-dark-900/15">
                <span class="chapter-fill block h-full origin-left bg-green-dark-900"></span>
              </span>
              <span class="mt-1.5 block text-xs font-semibold tracking-widest uppercase text-grey-900/60 transition-colors duration-300 group-hover/marker:text-green-dark-900 group-data-[active=true]/marker:text-green-dark-900">
                {label}
              </span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* The poster is a still of the 3d model; it covers the wait for the model
     and stays for readers without scripts. The drawing only stands in where
     webgl is missing. */
  .probe-sketch {
    opacity: 0;
  }

  [data-probe-view='sketch'] .probe-sketch {
    opacity: 1;
  }

  [data-probe-view='sketch'] .probe-poster {
    display: none;
  }

  /* Fades only once the model has faded in on top, so the picture never dips. */
  .probe-poster {
    transition: opacity 0.3s ease-out 0.5s;
  }

  [data-model-ready] .probe-poster {
    opacity: 0;
  }

  .soak-water {
    transform-box: fill-box;
    transform-origin: top;
    transform: scaleY(var(--soak-level));
    transition: transform 0.2s linear;
  }

  .soak-ring {
    opacity: 0;
    transition: opacity 0.4s ease-out;
  }

  .soak-point[data-reached] .soak-ring {
    opacity: 1;
  }

  /* Unpinned, the three chapters simply follow each other. Pinned, they share
     one place on the stage and crossfade as the reader scrolls on. */
  .hardware-chapters {
    display: grid;
    gap: 5rem;
  }

  .hardware-progress {
    display: none;
  }

  /* 150svh for each of the three chapters. */
  [data-pin-track][data-pinned] {
    --pin-distance: 450svh;
  }

  [data-pin-track][data-pinned] .hardware-chapters {
    gap: 0;
  }

  [data-pin-track][data-pinned] .hardware-chapter {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.5s ease-out,
      visibility 0s linear 0.5s;
  }

  [data-pin-track][data-pinned] .hardware-chapter[data-active='true'] {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.5s ease-out;
  }

  [data-pin-track][data-pinned] .hardware-progress {
    display: flex;
  }

  .chapter-fill {
    transform: scaleX(0);
  }

  [data-chapter-marker][data-passed] .chapter-fill {
    transform: scaleX(1);
  }

  [data-chapter-marker][data-active='true'] .chapter-fill {
    transform: scaleX(var(--chapter-fill, 0));
  }

  /* A tall window leaves the model room to grow. Tied to the window, not to
     the pinned state, so the pinning decision measures a stable height. */
  @media (min-width: 1024px) and (min-height: 1000px) {
    .probe-model {
      max-width: 28rem;
    }
  }

  .hardware-chapters {
    --ease-pop: cubic-bezier(0.34, 1.5, 0.64, 1);
  }

  .reading-pill {
    border-color: color-mix(in oklab, var(--color-grey-900) 20%, transparent);
    color: color-mix(in oklab, var(--color-grey-900) 65%, transparent);
    transition:
      color 0.3s ease-out,
      border-color 0.3s ease-out;
  }

  .reading-dot {
    background-color: currentColor;
    opacity: 0.5;
  }

  .reading-moist,
  .reading[data-reached] .reading-dry {
    display: none;
  }

  .reading[data-reached] .reading-moist {
    display: inline;
  }

  .reading[data-reached] .reading-pill {
    border-color: #3b6e8f;
    color: #2f5a76;
    animation: reading-pop 0.45s ease-out;
  }

  .reading[data-reached] .reading-dot {
    opacity: 1;
  }

  @keyframes reading-pop {
    0% {
      scale: 0.85;
    }
    55% {
      scale: 1.08;
    }
    100% {
      scale: 1;
    }
  }

  /* Everything below plays only on the pinned stage. Unpinned, and without
     scripts, the parts are simply there in their final state. */
  [data-pin-track][data-pinned] .spec-pill {
    transition:
      opacity 0.25s ease-out,
      translate 0.45s var(--ease-pop),
      scale 0.45s var(--ease-pop);
  }

  [data-pin-track][data-pinned] .spec-pill:not([data-shown]) {
    opacity: 0;
    translate: 0 0.6rem;
    scale: 0.9;
  }

  [data-pin-track][data-pinned] .setup-check {
    transition:
      background-color 0.25s ease-out,
      border-color 0.25s ease-out,
      color 0.25s ease-out,
      scale 0.45s var(--ease-pop);
  }

  [data-pin-track][data-pinned] .setup-label {
    transition: color 0.25s ease-out;
  }

  [data-pin-track][data-pinned] .setup-step:not([data-shown]) .setup-check {
    border-color: color-mix(in oklab, var(--color-grey-900) 30%, transparent);
    background-color: transparent;
    color: transparent;
    scale: 0.85;
  }

  [data-pin-track][data-pinned] .setup-step:not([data-shown]) .setup-label {
    color: color-mix(in oklab, var(--color-grey-900) 55%, transparent);
  }

  /* Sits on the qr code of the sensor unit in the photo, so both the photo's
     4:3 crop and these percentages have to change together. */
  .scan-frame {
    --corner: 30%;
    position: absolute;
    left: 42.8%;
    top: 47%;
    width: 15%;
    aspect-ratio: 1;
    translate: -50% -50%;
    border: 2px solid white;
    border-radius: 0.5rem;
    opacity: 0;
    mask:
      linear-gradient(#000 0 0) top left / var(--corner) var(--corner) no-repeat,
      linear-gradient(#000 0 0) top right / var(--corner) var(--corner) no-repeat,
      linear-gradient(#000 0 0) bottom left / var(--corner) var(--corner) no-repeat,
