---
import { CircleDot } from 'lucide-react'
import Button from '../../Button.astro'
import Github from '../../icons/Github.astro'
import Arrow from '../../icons/Arrow.astro'
import type { Language } from '../../../i18n/languages'
import { getTranslations } from '../../../i18n/t'
import { splitSlot } from '../../../lib/slotText'
import { streamletLimitations, streamletLinks } from '../../../data/streamlet'

interface Props {
  language: Language
}

const { language } = Astro.props
const t = getTranslations(language, 'streamlet')

// Replaces the Trans slot: the catalog keeps a neutral <release> marker.
const cta = splitSlot(t('status.cta.descriptionRich'), 'release')

const SECONDARY_CTA_CLASS =
  'flex items-center justify-center gap-x-3 rounded-2xl w-max font-semibold px-5 py-2 cursor-pointer transition-all ease-in-out duration-300 text-green-dark-900 border border-green-dark-900/30 hover:border-green-dark-900 hover:bg-white/70'
---

<section
  class="px-4 max-w-208 mx-auto my-20 md:px-6 lg:my-28 lg:max-w-screen-lg xl:my-36 xl:max-w-screen-xl"
>
  <div class="mb-10 lg:mb-14">
    <div class="inline-block mb-4">
      <span class="text-xs font-semibold tracking-widest text-green-light-900 uppercase">
        {t('status.sectionLabel')}
      </span>
      <div class="h-0.5 w-12 bg-gradient-to-r from-green-light-900 to-transparent mt-1"></div>
    </div>

    <h2 class="font-lato font-bold text-2xl mb-4 text-grey-900 lg:text-3xl xl:text-4xl">
      {t('status.title')}
    </h2>

    <p class="text-grey-900/70 leading-relaxed max-w-2xl">{t('status.description')}</p>
  </div>

  <ul class="space-y-3 mb-12">
    {
      streamletLimitations.map((limitation) => (
        <li class="flex items-start gap-3">
          <CircleDot
            className="w-5 h-5 flex-shrink-0 mt-0.5 text-green-light-900"
            aria-hidden="true"
          />
          <span class="text-grey-900/70 leading-relaxed">
            {t(`status.limitations.${limitation}`)}
          </span>
        </li>
      ))
    }
  </ul>

  <div class="rounded-2xl bg-green-light-100/70 border border-green-light-900/20 p-6 lg:p-10">
    <h3 class="font-lato font-bold text-xl text-grey-900 mb-3 lg:text-2xl">
      {t('status.cta.title')}
    </h3>

    <p class="text-grey-900/70 leading-relaxed max-w-2xl mb-8">
      {cta.before}<a
        href={`/${language}/releases/v0.4.0`}
        class="font-semibold text-green-dark-900 underline decoration-green-dark-900 decoration-2 underline-offset-2 transition-all hover:decoration-4"
        >{cta.inner}</a
      >{cta.after}
    </p>

    <div class="flex flex-wrap gap-4">
      <Button
        href={streamletLinks.repo}
        ariaLabel={t('status.cta.repoAriaLabel')}
        isExternalLink
        isDark
      >
        <Github class="w-5" />
        <span class="whitespace-nowrap">{t('status.cta.repo')}</span>
        <Arrow class="w-6 transition-all ease-in-out duration-300 group-hover:translate-x-2" />
      </Button>

      <a
        href={streamletLinks.issues}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t('status.cta.issuesAriaLabel')}
        class={SECONDARY_CTA_CLASS}
      >
        <span class="whitespace-nowrap">{t('status.cta.issues')}</span>
      </a>

      <a
        href={`/${language}`}
        aria-label={t('status.cta.homeAriaLabel')}
        class={SECONDARY_CTA_CLASS}
      >
        <span class="whitespace-nowrap">{t('status.cta.home')}</span>
      </a>

      <a
        href={`/${language}/contact`}
        aria-label={t('status.cta.contactAriaLabel')}
        class={SECONDARY_CTA_CLASS}
      >
        <span class="whitespace-nowrap">{t('status.cta.contact')}</span>
      </a>
    </div>
  </div>
</section>
