---
import type { Language } from '../../../i18n/languages'
import { getTranslations } from '../../../i18n/t'
import { splitSlot } from '../../../lib/slotText'
import { benefitNeeds } from '../../../data/streamlet'
import Arrow from '../../icons/Arrow.astro'
import Button from '../../Button.astro'

interface Props {
  language: Language
}

const { language } = Astro.props
const t = getTranslations(language, 'streamlet')

const integrated = splitSlot(t('benefit.integratedRich'), 'project')
---

<section
  class="px-4 max-w-208 mx-auto my-20 md:px-6 lg:my-28 lg:max-w-screen-lg xl:my-36 xl:max-w-screen-xl"
>
  <div class="mb-10 lg:mb-14">
    <div class="inline-block mb-4">
      <span class="text-xs font-semibold tracking-widest text-green-light-900 uppercase">
        {t('benefit.sectionLabel')}
      </span>
      <div class="h-0.5 w-12 bg-gradient-to-r from-green-light-900 to-transparent mt-1"></div>
    </div>

    <div class="lg:flex lg:justify-between lg:gap-12 xl:gap-16">
      <h2
        class="font-lato font-bold text-2xl mb-4 text-grey-900 lg:mb-0 lg:max-w-xs lg:shrink-0 lg:text-3xl xl:max-w-sm xl:text-4xl"
      >
        {t('benefit.title')}
      </h2>

      <p class="text-grey-900/70 leading-relaxed lg:max-w-2xl">{t('benefit.description')}</p>
    </div>
  </div>

  <h3 class="font-lato font-semibold text-grey-900 mb-4">{t('benefit.needs.title')}</h3>

  <ul class="grid grid-cols-1 gap-4 md:grid-cols-3 lg:gap-5">
    {
      benefitNeeds.map((need) => {
        const Icon = need.icon

        return (
          <li class="rounded-2xl border border-green-dark-900/10 bg-white p-5">
            <span class="flex w-10 h-10 rounded-lg bg-green-light-900/15 items-center justify-center mb-4">
              <Icon className="w-5 h-5 text-green-dark-900" aria-hidden="true" />
            </span>
            <h4 class="font-lato font-semibold text-grey-900 mb-2">
              {t(`benefit.needs.${need.id}.label`)}
            </h4>
            <p class="text-grey-900/70 leading-relaxed">
              {t(`benefit.needs.${need.id}.description`)}
            </p>
          </li>
        )
      })
    }
  </ul>

  <div class="mt-10 max-w-2xl border-l-2 border-green-light-900/30 pl-6 lg:mt-12">
    <h3 class="font-lato font-semibold text-grey-900 mb-2">
      {t('benefit.sensorsOptional.label')}
    </h3>
    <p class="text-grey-900/70 leading-relaxed">
      {t('benefit.sensorsOptional.description')}
    </p>
  </div>

  <p class="text-grey-900/70 leading-relaxed mt-10 max-w-2xl lg:mt-12">
    {integrated.before}<a
      href={`/${language}/project`}
      class="font-semibold text-green-dark-900 underline decoration-green-dark-900 decoration-2 underline-offset-2 transition-all hover:decoration-4"
      >{integrated.inner}</a
    >{integrated.after}
  </p>

  <div class="mt-8">
    <Button href={`/${language}/project#architecture`} ariaLabel={t('benefit.ctaAriaLabel')} isDark>
      <span>{t('benefit.cta')}</span>
      <Arrow class="w-6 transition-all ease-in-out duration-300 group-hover:translate-x-2" />
    </Button>
  </div>
</section>
