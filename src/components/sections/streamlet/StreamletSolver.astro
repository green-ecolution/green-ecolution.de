---
import type { Language } from '../../../i18n/languages'
import { getTranslations } from '../../../i18n/t'
import { solverBenchmarks, solverMoveEvaluationIcon, solverStages } from '../../../data/streamlet'

interface Props {
  language: Language
}

const MoveEvaluationIcon = solverMoveEvaluationIcon
const DOTS = 'radial-gradient(circle at 1px 1px, white 0.5px, transparent 0)'

const { language } = Astro.props
const t = getTranslations(language, 'streamlet')
---

<section id="solver" class="relative overflow-hidden bg-[#1a2a16]">
  <div
    class="absolute inset-0 opacity-[0.03]"
    style={`background-image: ${DOTS}; background-size: 20px 20px;`}
  >
  </div>
  <div
    class="absolute top-0 right-1/4 w-[40rem] h-[20rem] bg-green-dark-900/20 rounded-full blur-3xl"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 w-[25rem] h-[15rem] bg-green-middle-900/10 rounded-full blur-3xl translate-y-1/3"
  >
  </div>

  <div
    class="relative z-10 max-w-208 mx-auto px-4 py-20 md:px-6 lg:py-28 lg:max-w-screen-lg xl:py-36 xl:max-w-screen-xl"
  >
    <div class="mb-10 lg:mb-14">
      <div class="inline-block mb-6">
        <span class="text-xs font-semibold tracking-widest text-green-light-900 uppercase">
          {t('solver.sectionLabel')}
        </span>
        <div class="h-0.5 w-12 bg-gradient-to-r from-green-light-900 to-transparent mt-1"></div>
      </div>

      <h2 class="font-lato font-bold text-2xl mb-4 text-white lg:text-3xl xl:text-4xl">
        {t('solver.title')}
      </h2>

      <p class="text-white/60 leading-relaxed max-w-2xl">{t('solver.description')}</p>

      <p class="text-white/60 leading-relaxed max-w-2xl mt-4">{t('solver.termIntro')}</p>

      <p class="text-white/60 leading-relaxed max-w-2xl mt-4">{t('solver.priorEngine')}</p>
    </div>

    <div class="grid grid-cols-1 gap-6 mb-8 lg:grid-cols-2 lg:gap-8">
      {
        solverStages.map((stage) => {
          const Icon = stage.icon

          return (
            <article>
              <div class="mb-4 w-10 h-10 rounded-lg bg-green-dark-900/60 flex items-center justify-center">
                <Icon className="w-5 h-5 text-green-light-900" aria-hidden="true" />
              </div>
              <h3 class="font-lato font-semibold text-white mb-2">
                {t(`solver.stages.${stage.id}.label`)}
              </h3>
              <p class="text-sm text-white/60 leading-relaxed">
                {t(`solver.stages.${stage.id}.description`)}
              </p>
            </article>
          )
        })
      }
    </div>

    <div class="flex items-start gap-4 mb-12 border-l-2 border-green-light-900/40 pl-5">
      <MoveEvaluationIcon
        className="w-5 h-5 flex-shrink-0 mt-0.5 text-green-light-900"
        aria-hidden="true"
      />
      <p class="text-sm text-white/60 leading-relaxed max-w-2xl">
        <span class="font-semibold text-white">{t('solver.moveEvaluation.label')}.</span>{' '}
        {t('solver.moveEvaluation.description')}
      </p>
    </div>

    <div class="rounded-2xl border border-white/10 p-6 lg:p-8">
      <h3 class="font-lato font-semibold text-white mb-2">{t('solver.benchmarks.title')}</h3>
      <p class="text-sm text-white/60 leading-relaxed mb-6 max-w-2xl">
        {t('solver.benchmarks.description')}
      </p>

      <dl class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        {
          solverBenchmarks.map((benchmark) => (
            <div class="rounded-xl bg-white/[0.04] p-4">
              <dt class="font-mono text-xs uppercase tracking-widest text-white/50 mb-1">
                {benchmark.instance}
              </dt>
              <dd class="font-lato font-bold text-2xl text-green-light-900">
                {t('solver.benchmarks.gap', { value: benchmark.gap.toLocaleString(language) })}
              </dd>
            </div>
          ))
        }
      </dl>

      <p class="text-xs text-white/50 mt-3">{t('solver.benchmarks.footnote')}</p>
    </div>
  </div>
</section>
