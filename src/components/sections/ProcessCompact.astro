---
import { Image } from 'astro:assets'
import { ChevronDown } from 'lucide-react'
import Arrow from '../icons/Arrow.astro'
import wateringPhoto from '../../assets/photos/bewaesserung-jungbaum-tbz.jpg'
import measurePhoto from '../../assets/photos/sensor-ges-1000.jpg'
import sensorInstallation from '../../assets/illustrations/sensor-installation.png'
import mapOverview from '../../assets/releases/v0.3.0-karte-uebersicht.png'
import groupDashboard from '../../assets/releases/v0.5.0-gruppen-dashboard.png'
import routePlanning from '../../assets/releases/v0.4.0-route-nachfuellpunkte.png'
import type { Language } from '../../i18n/languages'
import { getTranslations } from '../../i18n/t'
import { workflowSteps } from '../../data/workflowSteps'

interface Props {
  language: Language
}

const { language } = Astro.props
const t = getTranslations(language, 'home')

// The router Link carried hash="process"; as a plain anchor the fragment goes
// straight into the href.
const moreHref = `/${language}/product#process`
// Screenshots crop from the top left, where the app's navigation anchors them;
// photos keep their subjects in the middle. The installation sketch anchors at
// the bottom so a 16:9 crop trims the treetop, not the depth labels. A step
// with several visuals plays them in turn while it is open.
const VISUALS = {
  measure: [
    {
      src: measurePhoto,
      position: 'object-center',
      alt: t('workflow.steps.measure.screenshotAlt'),
      caption: null,
    },
    {
      src: sensorInstallation,
      position: 'object-bottom',
      alt: t('workflow.steps.measure.installationAlt'),
      caption: null,
    },
  ],
  understand: [
    {
      src: mapOverview,
      position: 'object-left-top',
      alt: t('workflow.steps.understand.screenshotAlt'),
      caption: null,
    },
    {
      src: groupDashboard,
      position: 'object-left-top',
      alt: t('workflow.steps.understand.dashboardAlt'),
      caption: null,
    },
  ],
  act: [
    {
      src: routePlanning,
      position: 'object-left-top',
      alt: t('workflow.steps.act.screenshotAlt'),
      caption: null,
    },
    {
      src: wateringPhoto,
      position: 'object-center',
      alt: t('workflow.photoAlt'),
      caption: t('workflow.photoCaption'),
    },
  ],
}
const pinDistance = `${Object.values(VISUALS).flat().length * 50}svh`
---

<section class="max-w-208 mx-auto my-20 px-4 md:px-6 lg:my-28 lg:max-w-screen-lg xl:my-36 xl:max-w-screen-xl">
  <div data-pin-track style={`--pin-distance: ${pinDistance}`}>
    <div data-pin-stage>
      <div class="w-full mb-8 lg:grid lg:grid-cols-12 lg:gap-x-10 lg:items-start lg:mb-8 xl:gap-x-16">
        <div class="lg:contents">
          <div class="mb-4 lg:col-span-12">
            <div class="inline-block">
              <span class="text-xs font-semibold tracking-widest text-green-dark-900 uppercase">
                {t('workflow.sectionLabel')}
              </span>
              <div class="h-0.5 w-12 bg-gradient-to-r from-green-light-900 to-transparent mt-1"></div>
            </div>
          </div>

          <h2 class="font-lato font-bold text-2xl text-grey-900 lg:col-span-5 lg:text-3xl xl:text-4xl">
            {t('workflow.title')}
          </h2>
        </div>

        <div class="lg:col-span-7">
          <p class="mt-4 max-w-2xl text-grey-900/70 leading-relaxed lg:mt-0">
            {t('workflow.description')}
          </p>
          <a
            href={moreHref}
            aria-label={t('workflow.moreLinkAriaLabel')}
            class="hidden lg:inline-flex mt-3 group items-center gap-x-2 font-semibold text-green-dark-900 hover:text-green-light-900 transition-colors duration-300 whitespace-nowrap"
          >
            {t('workflow.moreLink')}
            <Arrow class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" />
          </a>
        </div>
      </div>

      <div
        data-workflow
        class="grid w-full gap-8 md:grid-cols-12 md:items-center lg:gap-10 xl:gap-16"
      >
        <div class="relative aspect-[16/10] overflow-hidden rounded-2xl lg:aspect-video bg-white shadow-xl ring-1 ring-grey-900/10 md:col-span-6 lg:col-span-7">
          {workflowSteps.flatMap((step, index) =>
            VISUALS[step.id].map((visual, phase) => {
              const isFirst = index === 0 && phase === 0
              return (
                <figure
                  data-step-visual={index}
                  data-step-phase={phase}
                  data-active={String(isFirst)}
                  aria-hidden={isFirst ? undefined : 'true'}
                  class="absolute inset-0 opacity-0 transition-opacity duration-500 ease-out data-[active=true]:opacity-100 motion-reduce:transition-none"
                >
                  <Image
                    src={visual.src}
                    alt={visual.alt}
                    widths={[640, 960, 1280, 1600]}
                    sizes="(min-width: 1280px) 720px, (min-width: 1024px) 58vw, (min-width: 768px) 50vw, 100vw"
                    loading="lazy"
                    class:list={['w-full h-full object-cover', visual.position]}
                  />
                  {visual.caption && (
                    <figcaption class="absolute left-3 bottom-3 rounded-full bg-white/90 px-3 py-1 text-xs text-grey-900">
                      {visual.caption}
                    </figcaption>
                  )}
                </figure>
              )
            }),
          )}
        </div>

        <ol class="border-t border-green-dark-900/15 md:col-span-6 lg:col-span-5">
          {workflowSteps.map((step, index) => {
            const Icon = step.icon
            const panelId = `workflow-panel-${step.id}`

            return (
              <li
                data-step={index}
                data-active={String(index === 0)}
                class="group relative border-b border-green-dark-900/15"
              >
                <span
                  aria-hidden="true"
                  class="absolute left-0 top-0 h-full w-0.5 bg-transparent transition-colors duration-300 group-data-[active=true]:bg-green-dark-900/15"
                >
                  <span class="workflow-fill block h-full w-full origin-top bg-green-dark-900 scale-y-0 group-data-[active=true]:scale-y-(--step-fill,1)"></span>
                </span>
                <h3>
                  <button
                    type="button"
                    data-step-trigger={index}
                    aria-expanded={String(index === 0)}
                    aria-controls={panelId}
                    class="flex w-full items-center gap-x-4 py-4 pl-5 pr-2 text-left cursor-pointer rounded-lg transition-colors hover:bg-green-light-100/50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-dark-900"
                  >
                    <span class="flex shrink-0 w-11 h-11 rounded-full items-center justify-center bg-green-light-100 text-green-dark-900 ring-1 ring-green-light-900/30 transition-colors duration-300 group-data-[active=true]:bg-green-dark-900 group-data-[active=true]:text-white group-data-[active=true]:ring-green-dark-900">
                      <Icon className="w-5 h-5" aria-hidden="true" />
                    </span>
                    <span class="flex-1">
                      <span class="block text-xs font-semibold tracking-widest uppercase text-green-dark-900 mb-1">
                        {step.number} · {t(`workflow.steps.${step.id}.category`)}
                      </span>
                      <span class="block font-lato font-bold text-xl text-grey-900 lg:text-2xl">
                        {t(`workflow.steps.${step.id}.title`)}
                      </span>
                    </span>
                    <ChevronDown
                      aria-hidden="true"
                      className="w-5 h-5 shrink-0 text-green-dark-900 transition-transform duration-300 group-data-[active=true]:rotate-180 motion-reduce:transition-none"
                    />
                  </button>
                </h3>
                <div id={panelId} class="workflow-panel">
                  <div>
                    <p class="pb-6 pl-5 pr-2 sm:pl-[4.75rem] text-grey-900/70 leading-relaxed">
                      {t(`workflow.steps.${step.id}.description`)}
                    </p>
                  </div>
                </div>
              </li>
            )
          })}
        </ol>
      </div>
    </div>
  </div>

  <div class="flex justify-center mt-8 lg:hidden">
    <a
      href={moreHref}
      aria-label={t('workflow.moreLinkAriaLabel')}
      class="group flex items-center gap-x-2 font-semibold text-green-dark-900 hover:text-green-light-900 transition-colors duration-300"
    >
      {t('workflow.moreLink')}
      <Arrow class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" />
    </a>
  </div>
</section>

<style>
  .workflow-panel {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .workflow-panel > div {
    overflow: hidden;
  }

  /* Collapsing waits for the script, so without it every step stays readable. */
  [data-workflow][data-enhanced] [data-step]:not([data-active='true']) .workflow-panel {
    grid-template-rows: 0fr;
  }

  @media (prefers-reduced-motion: reduce) {
    .workflow-panel {
      transition: none;
    }
  }
</style>

<script>
  import '../../scripts/workflowSteps'
</script>
