---
import { Image } from 'astro:assets'
import Arrow from '../icons/Arrow.astro'
import wateringPhoto from '../../assets/photos/bewaesserung-jungbaum-tbz.jpg'
import measurePhoto from '../../assets/photos/sensor-messung-progeek.jpg'
import sensorDetail from '../../assets/screens/sensor-detail.png'
import routePlanning from '../../assets/releases/v0.4.0-route-nachfuellpunkte.png'
import type { Language } from '../../i18n/languages'
import { getTranslations } from '../../i18n/t'
import { workflowSteps } from '../../data/workflowSteps'

interface Props {
  language: Language
}

const { language } = Astro.props
const t = getTranslations(language, 'home')

// The router Link carried hash="process"; as a plain anchor the fragment goes
// straight into the href.
const moreHref = `/${language}/product#process`
// Screenshots crop from the top left, where the app's navigation anchors them;
// the photo keeps its subjects in the middle.
const VISUALS = {
  measure: { src: measurePhoto, position: 'object-center' },
  understand: { src: sensorDetail, position: 'object-left-top' },
  act: { src: routePlanning, position: 'object-left-top' },
}
---

<section class="max-w-208 mx-auto my-20 px-4 md:px-6 lg:my-28 lg:max-w-screen-lg xl:my-36 xl:max-w-screen-xl">
  <div class="flex items-end justify-between mb-8 lg:mb-12">
    <div>
      <div class="inline-block mb-4">
        <span class="text-xs font-semibold tracking-widest text-green-dark-900 uppercase">
          {t('workflow.sectionLabel')}
        </span>
        <div class="h-0.5 w-12 bg-gradient-to-r from-green-light-900 to-transparent mt-1"></div>
      </div>

      <h2 class="font-lato font-bold text-2xl text-grey-900 lg:text-3xl xl:text-4xl">
        {t('workflow.title')}
      </h2>
      <p class="mt-4 max-w-2xl text-grey-900/70 leading-relaxed">{t('workflow.description')}</p>
    </div>

    <a
      href={moreHref}
      aria-label={t('workflow.moreLinkAriaLabel')}
      class="hidden lg:flex group items-center gap-x-2 font-semibold text-green-dark-900 hover:text-green-light-900 transition-colors duration-300 whitespace-nowrap"
    >
      {t('workflow.moreLink')}
      <Arrow class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" />
    </a>
  </div>

  <div data-scroll-steps class="lg:grid lg:grid-cols-12 lg:gap-10 xl:gap-16">
    <div class="hidden lg:block lg:col-span-7">
      <div class="sticky top-28">
        <div class="relative aspect-[16/10] overflow-hidden rounded-2xl bg-white shadow-xl ring-1 ring-grey-900/10">
          {workflowSteps.map((step, index) => (
            <Image
              src={VISUALS[step.id].src}
              alt={t(`workflow.steps.${step.id}.screenshotAlt`)}
              widths={[800, 1200, 1600]}
              sizes="(min-width: 1280px) 720px, 58vw"
              loading="lazy"
              data-step-visual={index}
              data-active={String(index === 0)}
              class:list={[
                'absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-500 ease-out data-[active=true]:opacity-100 motion-reduce:transition-none',
                VISUALS[step.id].position,
              ]}
            />
          ))}
        </div>
        <div class="flex gap-2 mt-4" aria-hidden="true">
          {workflowSteps.map((_, index) => (
            <span
              data-step-visual={index}
              data-active={String(index === 0)}
              class="h-1 w-8 rounded-full bg-green-dark-900/15 transition-colors duration-300 data-[active=true]:bg-green-dark-900"
            ></span>
          ))}
        </div>
      </div>
    </div>

    <ol class="lg:col-span-5">
      {workflowSteps.map((step, index) => {
        const Icon = step.icon

        return (
          <li
            data-step={index}
            data-active={String(index === 0)}
            class="group relative border-t border-green-dark-900/15 py-8 first:border-t-0 first:pt-0 lg:border-t-0 lg:py-0 lg:pl-8 lg:min-h-[70vh] lg:last:min-h-[60vh]"
          >
            <span
              aria-hidden="true"
              class="hidden lg:block absolute left-0 top-0 h-full w-0.5 rounded-full bg-green-dark-900/15 transition-colors duration-300 group-data-[active=true]:bg-green-dark-900"
            ></span>
            <Icon className="w-8 h-8 text-green-dark-900/50 mb-5 transition-colors duration-300 group-data-[active=true]:text-green-dark-900 lg:w-10 lg:h-10" />

            <span class="text-xs font-semibold tracking-widest uppercase text-green-dark-900 block mb-2">
              {step.number} · {t(`workflow.steps.${step.id}.category`)}
            </span>

            <h3 class="font-lato font-bold text-xl text-grey-900 mb-3 lg:text-2xl xl:text-3xl">
              {t(`workflow.steps.${step.id}.title`)}
            </h3>

            <p class="text-grey-900/70 leading-relaxed">
              {t(`workflow.steps.${step.id}.description`)}
            </p>

            <Image
              src={VISUALS[step.id].src}
              alt={t(`workflow.steps.${step.id}.screenshotAlt`)}
              widths={[640, 960]}
              sizes="100vw"
              loading="lazy"
              class:list={[
                'mt-6 w-full aspect-[16/10] object-cover rounded-xl shadow-md ring-1 ring-grey-900/10 lg:hidden',
                VISUALS[step.id].position,
              ]}
            />
          </li>
        )
      })}
    </ol>
  </div>

  <div class="mt-10 lg:mt-14 lg:grid lg:grid-cols-12 lg:gap-10 lg:items-center">
    <div class="lg:col-span-5">
      <p class="text-grey-900/70 leading-relaxed lg:text-lg">{t('workflow.photoLead')}</p>
    </div>

    <figure class="mt-8 lg:mt-0 lg:col-span-7">
      <Image
        src={wateringPhoto}
        alt={t('workflow.photoAlt')}
        widths={[640, 960, 1280]}
        sizes="(min-width: 1024px) 58vw, 100vw"
        loading="lazy"
        class="w-full aspect-[4/3] object-cover rounded-xl sm:aspect-[3/2]"
      />

      <figcaption class="mt-3 text-sm text-grey-900/60">{t('workflow.photoCaption')}</figcaption>
    </figure>
  </div>

  <div class="flex justify-center mt-8 lg:hidden">
    <a
      href={moreHref}
      aria-label={t('workflow.moreLinkAriaLabel')}
      class="group flex items-center gap-x-2 font-semibold text-green-dark-900 hover:text-green-light-900 transition-colors duration-300"
    >
      {t('workflow.moreLink')}
      <Arrow class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" />
    </a>
  </div>
</section>

<script>
  import '../../scripts/scrollSteps'
</script>
