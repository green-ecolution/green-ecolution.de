---
import type { Language } from '../../i18n/languages'
import { getTranslations } from '../../i18n/t'
import { targetGroups } from '../../data/targetGroups'
import { Image } from 'astro:assets'
import fieldPhoto from '../../assets/photos/einsatz-jungbaum-tablet.jpg'
import Arrow from '../icons/Arrow.astro'
import Button from '../Button.astro'

interface Props {
  language: Language
}

const { language } = Astro.props
const t = getTranslations(language, 'home')
---

<section
  id="zielgruppen"
  class="max-w-208 mx-auto my-20 px-4 md:px-6 lg:my-28 lg:max-w-screen-lg lg:grid lg:grid-cols-12 lg:gap-x-10 xl:my-36 xl:max-w-screen-xl xl:gap-x-16"
>
  <div class="mb-8 lg:col-span-7 lg:col-start-6 lg:row-start-1 lg:mb-10">
    <div class="inline-block mb-4">
      <span class="text-xs font-semibold tracking-widest text-green-dark-900 uppercase">
        {t('targetGroups.sectionLabel')}
      </span>
      <div class="h-0.5 w-12 bg-gradient-to-r from-green-light-900 to-transparent mt-1"></div>
    </div>
    <h2 class="font-lato font-bold text-2xl mb-4 text-grey-900 lg:text-3xl xl:text-4xl">
      {t('targetGroups.title')}
    </h2>
    <p class="text-grey-900/70 leading-relaxed">{t('targetGroups.description')}</p>
  </div>

  <figure class="mb-10 lg:col-span-5 lg:col-start-1 lg:row-span-2 lg:row-start-1 lg:mb-0 lg:sticky lg:top-28 lg:self-start">
    <Image
      src={fieldPhoto}
      alt={t('targetGroups.photoAlt')}
      widths={[640, 960, 1200]}
      sizes="(min-width: 1024px) 40vw, 100vw"
      loading="lazy"
      class="w-full aspect-[3/2] object-cover object-[40%_50%] rounded-2xl lg:aspect-square"
    />
    <figcaption class="mt-4 text-grey-900/70 leading-relaxed">
      {t('targetGroups.photoLead')}
    </figcaption>
  </figure>

  <div class="lg:col-span-7 lg:col-start-6 lg:row-start-2">
    <ul class="border-t border-grey-900/15">
      {targetGroups.map(({ id, icon: Icon }) => (
        <li class="group relative flex gap-x-5 py-6 border-b border-grey-900/15 lg:py-7">
          <span
            aria-hidden="true"
            class="absolute left-0 -top-px h-px w-0 bg-green-dark-900 transition-all duration-500 ease-out group-hover:w-full motion-reduce:transition-none"
          ></span>
          <span class="flex shrink-0 w-11 h-11 rounded-full bg-green-light-100 ring-1 ring-green-light-900/30 items-center justify-center text-green-dark-900 transition-colors duration-300 group-hover:bg-green-dark-900 group-hover:text-white">
            <Icon className="w-5 h-5" aria-hidden="true" />
          </span>
          <div>
            <h3 class="font-lato font-bold text-lg text-grey-900 mb-1 lg:text-xl">
              {t(`targetGroups.items.${id}.role`)}
            </h3>
            <p class="text-grey-900/70 leading-relaxed">
              {t(`targetGroups.items.${id}.description`)}
            </p>
          </div>
        </li>
      ))}
    </ul>

    <div class="mt-8 lg:mt-10">
      <Button
        href={`/${language}/product#requirements`}
        ariaLabel={t('targetGroups.ctaAriaLabel')}
        isDark
      >
        <span>{t('targetGroups.cta')}</span>
        <Arrow class="w-6 transition-all ease-in-out duration-300 group-hover:translate-x-2" />
      </Button>
    </div>

    <p class="text-grey-900/70 leading-relaxed mt-10">{t('targetGroups.closing')}</p>
  </div>
</section>
