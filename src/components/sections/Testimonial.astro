---
import type { Language } from '../../i18n/languages'
import { getTranslations } from '../../i18n/t'

interface Props {
  language: Language
  compact?: boolean
}

const { language, compact = false } = Astro.props
const t = getTranslations(language, 'common')
const words = t('testimonial.quote').split(' ')
---

<section
  class:list={[
    'px-4 max-w-208 mx-auto md:px-6 lg:max-w-screen-lg xl:max-w-screen-xl',
    compact ? 'my-16 lg:my-20' : 'my-20 lg:my-28 xl:my-36',
  ]}
>
  <div class="inline-block mb-6 lg:mb-8">
    <span class="text-xs font-semibold tracking-widest text-green-dark-900 uppercase">
      {t('testimonial.sectionLabel')}
    </span>
    <div class="label-rule"></div>
  </div>

  <figure class="border-l-2 border-green-light-900/30 pl-6 lg:pl-8">
    <blockquote>
      <p
        data-scroll-progress
        data-progress-start="0.6"
        data-progress-end="0.35"
        style={`--words: ${words.length}`}
        class:list={[
          'max-w-4xl font-lato text-grey-900 leading-snug',
          compact ? 'text-lg lg:text-xl' : 'text-xl lg:text-2xl xl:text-3xl',
        ]}
      >
        {words.map((word, index) => (
          <>
            <span class="quote-word" style={`--i: ${index}`}>
              {word}
            </span>{' '}
          </>
        ))}
      </p>
    </blockquote>
    <figcaption class="mt-6 text-grey-900/70">
      <span class="block font-semibold text-grey-900">{t('testimonial.name')}</span>
      <span>{t('testimonial.role')}</span>
    </figcaption>
  </figure>
</section>

<style>
  /* The words light up in reading order as the quote travels up the window,
     starting around its middle, where it is actually being read.
     --lead is how many of them are on their way at the same time. The progress
     comes from src/scripts/scrollProgress.ts, loaded by the layout; without it
     the progress is 1 and the whole quote is simply there. */
  .quote-word {
    --lead: 5;
    opacity: clamp(
      0.25,
      0.25 + (var(--scroll-progress, 1) * (var(--words) + var(--lead)) - var(--i)) / var(--lead) *
        0.75,
      1
    );
    transition: opacity 0.2s linear;
  }
</style>
