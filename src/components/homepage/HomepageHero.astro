---
import { ExternalLink } from 'lucide-react'
import Arrow from '../icons/Arrow.astro'
import HeroTreesIsland from '../islands/hero/HeroTreesIsland'
import type { Language } from '../../i18n/languages'
import { getTranslations } from '../../i18n/t'
import { workflowSteps } from '../../data/workflowSteps'

interface Props {
  language: Language
}

const { language } = Astro.props
const t = getTranslations(language, 'home')

// Each word of the tagline names one step of the workflow further down, in the
// same order, so it can jump there.
const taglineWords = t('hero.tagline').split(' ')
const taglineJumps = taglineWords.length === workflowSteps.length

const HILL_FRONT =
  'M1031.42 463.293C706.291 573.793 283.625 419.293 283.625 419.293C283.625 419.293 38.6662 329.293 9.62605 450.293C-26.3741 600.293 45.4088 794.696 237.967 773.108C545.702 738.608 655.626 688.293 1024.62 843.793C1282.62 952.517 1403.81 970.255 1475.12 972.793C1615.62 977.793 1710.11 891.293 1702.62 802.793C1695.13 714.293 1605.12 620.793 1564.62 585.293C1524.12 549.793 1303.24 370.909 1031.42 463.293Z'
const HILL_BACK_A =
  'M930.302 149.578C781.802 381.078 254.501 449.984 114.501 416.484L243.768 629.878C598.056 669.547 1324.28 759.146 1394.86 800.183C1483.09 851.479 1692.38 759.146 1762.15 586.789C1817.96 448.904 1646.17 237.863 1553.3 149.578C1416.3 -17.4224 1076.49 -78.3149 930.302 149.578Z'
const HILL_BACK_B =
  'M1308.3 225.623C1405.1 173.223 1466.35 267.578 1534.39 324.15C1613.42 389.856 1655.45 488.299 1620.57 633.982C1609.38 680.694 1458.47 796.079 1411.28 759.145C1373.52 729.598 915.896 596.819 691.802 534.123C791.135 447.623 1008.7 280.623 1084.3 304.623C1178.8 334.623 1187.3 291.123 1308.3 225.623Z'
---

<section data-pause-offscreen>
  <div class="flex flex-col overflow-x-clip relative mx-auto w-full min-h-svh max-w-screen-3xl pointer-events-none before:bg-background-yellow-dot before:bg-cover before:w-4/5 before:h-[100vh] before:max-h-[45rem] before:absolute before:-right-4 before:bottom-0 before:-z-50 before:bg-no-repeat sm:before:-right-10 md:before:max-h-[70rem] 2xl:before:right-0 2xl:before:bg-contain">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="hero-glow absolute top-[calc(25%-10rem)] -left-60 w-[60rem] h-[60rem]"></div>
    </div>

    <article class="pointer-events-auto w-full max-w-208 mx-auto px-4 pt-28 md:px-6 lg:pt-36 lg:max-w-screen-lg lg:short:pt-28 xl:max-w-screen-xl xl:pt-44 xl:short:pt-32">
      <div class="max-w-[30rem] md:max-w-[34rem] xl:max-w-[38rem] 2xl:max-w-[42rem]">
        <h1
          class="hero-rise hero-rise-opaque font-lato font-bold text-4xl mb-6 text-grey-900 md:text-5xl xl:text-6xl"
          style="--rise-delay: 150ms"
        >
          {t('hero.headlinePrefix')}
          <span class="relative inline-block">
            <span class="relative z-10">{t('hero.headlineHighlight')}</span>
            <span
              class="hero-underline absolute -bottom-1 left-0 h-3 bg-green-light-900/30 -z-0 rounded-xs"
              style="--rise-delay: 600ms"
            ></span>
          </span>
          {t('hero.headlineSuffix')}
        </h1>

        <p
          class="hero-rise mb-4 font-lato text-sm tracking-widest uppercase text-green-dark-900 lg:text-base"
          style="--rise-delay: 250ms"
        >
          {taglineJumps
            ? taglineWords.map((word, index) => (
                <>
                  <a href="#workflow" data-workflow-jump={index} class="tagline-jump">
                    {word}
                  </a>{' '}
                </>
              ))
            : t('hero.tagline')}
        </p>

        <p
          class="hero-rise mb-6 text-grey-900/80 leading-relaxed lg:mb-8 lg:text-lg"
          style="--rise-delay: 350ms"
        >
          {t('hero.description')}
        </p>

        <div class="hero-rise flex flex-wrap items-center gap-3" style="--rise-delay: 500ms">
          <a
            href={`/${language}/contact`}
            class="flex items-center justify-center gap-x-3 rounded-2xl w-max font-semibold px-6 py-3 group bg-green-dark-900 text-white shadow-lg shadow-green-dark-900/25 transition-all ease-out duration-200 hover:shadow-xl hover:shadow-green-dark-900/30 hover:-translate-y-0.5 hover:gap-x-4 active:scale-[0.97] active:translate-y-0 active:duration-75"
          >
            <span>{t('hero.ctaContact')}</span>
            <Arrow class="w-5 transition-transform duration-300 group-hover:translate-x-1" />
          </a>
          <a
            href="https://demo.green-ecolution.de"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center justify-center gap-x-2 rounded-2xl w-max font-semibold px-6 py-3 bg-white/70 text-green-dark-900 border border-green-dark-900/30 transition-all ease-out duration-200 hover:bg-green-light-100 hover:border-green-dark-900/60 hover:-translate-y-0.5 active:scale-[0.97] active:translate-y-0 active:duration-75"
          >
            <span>{t('hero.ctaDemo')}</span>
            <span class="sr-only">{t('hero.ctaDemoNewTab')}</span>
            <ExternalLink
              aria-hidden="true"
              className="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            />
          </a>
        </div>
      </div>
    </article>

    <div class="hero-scene" aria-hidden="true">
      <svg class="hero-hills" viewBox="0 0 1774 973" preserveAspectRatio="none">
        <path d={HILL_BACK_A} fill="#ACB63B" fill-opacity="0.25"></path>
        <path d={HILL_BACK_B} fill="#ACB63B" fill-opacity="0.3"></path>
      </svg>
      <!-- Decoration: react and lottie-web can wait until the first screen stands. -->
      <HeroTreesIsland client:idle />
      <svg class="hero-hills" viewBox="0 0 1774 973" preserveAspectRatio="none">
        <path d={HILL_FRONT} fill="#4C7741"></path>
      </svg>
    </div>
  </div>
</section>

<style>
  /* The soft light behind the headline. The stops follow what a 60px blur
     makes of a 40rem radial gradient, so it looks the same without a filter:
     the trees move in front of it, and a filter is computed again for every
     frame that repaints what it covers. */
  .hero-glow {
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, rgb(172 182 59) 9.18%, transparent) 0%,
      color-mix(in srgb, rgb(172 182 59) 8.74%, transparent) 10%,
      color-mix(in srgb, rgb(172 182 59) 7.59%, transparent) 20%,
      color-mix(in srgb, rgb(172 182 59) 6.06%, transparent) 30%,
      color-mix(in srgb, rgb(172 182 59) 4.39%, transparent) 40%,
      color-mix(in srgb, rgb(172 182 59) 2.75%, transparent) 50%,
      color-mix(in srgb, rgb(172 182 59) 1.38%, transparent) 60%,
      color-mix(in srgb, rgb(172 182 59) 0.5%, transparent) 70%,
      color-mix(in srgb, rgb(172 182 59) 0.12%, transparent) 80%,
      color-mix(in srgb, rgb(172 182 59) 0.02%, transparent) 90%,
      transparent 100%
    );
  }

  /* A line that draws itself under the word says it leads somewhere, without
     underlining the tagline at rest. */
  .tagline-jump {
    padding-bottom: 0.2em;
    background: linear-gradient(currentColor, currentColor) left bottom / 0 1px no-repeat;
    transition: background-size 0.3s var(--ease-brand);
  }

  .tagline-jump:hover,
  .tagline-jump:focus-visible {
    background-size: 100% 1px;
  }

  @media (prefers-reduced-motion: reduce) {
    .tagline-jump {
      transition: none;
    }
  }
</style>
