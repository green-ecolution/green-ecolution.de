---
import { ExternalLink } from 'lucide-react'
import Arrow from '../icons/Arrow.astro'
import HeroTreesIsland from '../islands/hero/HeroTreesIsland'
import type { Language } from '../../i18n/languages'
import { getTranslations } from '../../i18n/t'
import { workflowSteps } from '../../data/workflowSteps'

interface Props {
  language: Language
}

const { language } = Astro.props
const t = getTranslations(language, 'home')

// Each word of the tagline names one step of the workflow further down, in the
// same order, so it can jump there.
const taglineWords = t('hero.tagline').split(' ')
const taglineJumps = taglineWords.length === workflowSteps.length
---

<section>
  <div class="overflow-hidden relative mx-auto w-full min-h-svh max-w-screen-3xl pointer-events-none before:bg-background-yellow-dot before:bg-cover before:w-4/5 before:h-[100vh] before:max-h-[45rem] before:absolute before:-right-4 before:bottom-0 before:-z-50 before:bg-no-repeat sm:before:-right-10 md:before:max-h-[70rem] 2xl:before:right-0 2xl:before:bg-contain">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div
        class="absolute top-1/4 -left-20 w-[40rem] h-[40rem] opacity-30"
        style="background: radial-gradient(ellipse at center, rgba(172, 182, 59, 0.4) 0%, transparent 70%); filter: blur(60px); transform: rotate(-15deg);"
      ></div>
    </div>

    <article class="pointer-events-auto max-w-208 mx-auto px-4 pt-28 mb-8 md:px-6 lg:mb-14 lg:pt-36 lg:max-w-screen-lg xl:max-w-screen-xl xl:pt-44">
      <div class="max-w-[30rem] md:max-w-[34rem] xl:max-w-[38rem] 2xl:max-w-[42rem]">
        <h1
          class="hero-rise font-lato font-bold text-4xl mb-6 text-grey-900 md:text-5xl xl:text-6xl"
          style="--rise-delay: 150ms"
        >
          {t('hero.headlinePrefix')}
          <span class="relative inline-block">
            <span class="relative z-10">{t('hero.headlineHighlight')}</span>
            <span
              class="hero-underline absolute -bottom-1 left-0 h-3 bg-green-light-900/30 -z-0 rounded-xs"
              style="--rise-delay: 600ms"
            ></span>
          </span>
          {t('hero.headlineSuffix')}
        </h1>

        <p
          class="hero-rise mb-4 font-lato text-sm tracking-widest uppercase text-green-dark-900 lg:text-base"
          style="--rise-delay: 250ms"
        >
          {taglineJumps
            ? taglineWords.map((word, index) => (
                <>
                  <a href="#workflow" data-workflow-jump={index} class="tagline-jump">
                    {word}
                  </a>{' '}
                </>
              ))
            : t('hero.tagline')}
        </p>

        <p
          class="hero-rise mb-6 text-grey-900/80 leading-relaxed lg:mb-8 lg:text-lg"
          style="--rise-delay: 350ms"
        >
          {t('hero.description')}
        </p>

        <div class="hero-rise flex flex-wrap items-center gap-3" style="--rise-delay: 500ms">
          <a
            href={`/${language}/contact`}
            class="flex items-center justify-center gap-x-3 rounded-2xl w-max font-semibold px-6 py-3 group bg-green-dark-900 text-white shadow-lg shadow-green-dark-900/25 transition-all ease-out duration-200 hover:shadow-xl hover:shadow-green-dark-900/30 hover:-translate-y-0.5 hover:gap-x-4 active:scale-[0.97] active:translate-y-0 active:duration-75"
          >
            <span>{t('hero.ctaContact')}</span>
            <Arrow class="w-5 transition-transform duration-300 group-hover:translate-x-1" />
          </a>
          <a
            href="https://demo.green-ecolution.de"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center justify-center gap-x-2 rounded-2xl w-max font-semibold px-6 py-3 bg-white/70 text-green-dark-900 border border-green-dark-900/30 transition-all ease-out duration-200 hover:bg-green-light-100 hover:border-green-dark-900/60 hover:-translate-y-0.5 active:scale-[0.97] active:translate-y-0 active:duration-75"
          >
            <span>{t('hero.ctaDemo')}</span>
            <span class="sr-only">{t('hero.ctaDemoNewTab')}</span>
            <ExternalLink
              aria-hidden="true"
              className="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            />
          </a>
        </div>
      </div>
    </article>

    <HeroTreesIsland client:visible />
  </div>
</section>

<style>
  /* A line that draws itself under the word says it leads somewhere, without
     underlining the tagline at rest. */
  .tagline-jump {
    padding-bottom: 0.2em;
    background: linear-gradient(currentColor, currentColor) left bottom / 0 1px no-repeat;
    transition: background-size 0.3s var(--ease-brand);
  }

  .tagline-jump:hover,
  .tagline-jump:focus-visible {
    background-size: 100% 1px;
  }

  @media (prefers-reduced-motion: reduce) {
    .tagline-jump {
      transition: none;
    }
  }
</style>
