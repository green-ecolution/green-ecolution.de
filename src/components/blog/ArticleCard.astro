---
import { Image } from 'astro:assets'
import { ArrowRight } from 'lucide-react'
import AuthorByline from '../AuthorByline.astro'
import type { Language } from '../../i18n/languages'
import { formatLongDate, isoDate } from '../../lib/formatDate'
import { articleSlug, type ArticleEntry } from '../../lib/blog'
import { getAuthor } from '../../lib/authors'

interface Props {
  entry: ArticleEntry
  language: Language
}

const { entry, language } = Astro.props
const { data } = entry
const author = await getAuthor(entry)
const href = `/${language}/blog/${articleSlug(entry)}`
---

<article class="group">
  <a href={href} class="block h-full">
    <div class="h-full flex flex-col bg-white rounded-xl lg:rounded-2xl overflow-hidden border border-grey-900/10 shadow-xs transition-all duration-300 group-hover:shadow-lg group-hover:-translate-y-0.5 group-hover:border-green-dark-900/20">
      <Image
        src={data.cover}
        alt={data.coverAlt}
        width={800}
        height={450}
        class="w-full aspect-video object-cover"
      />

      <div class="flex flex-col flex-grow p-5 lg:p-6">
        <time datetime={isoDate(data.date)} class="text-grey-900/50 text-sm">
          {formatLongDate(data.date, language)}
        </time>

        <h2 class="mt-2 font-lato font-bold text-lg lg:text-xl text-grey-900 transition-colors group-hover:text-green-dark-900">
          {data.title}
        </h2>

        <p class="mt-3 mb-5 text-grey-900/70 leading-relaxed line-clamp-3">{data.summary}</p>

        <div class="mt-auto pt-4 border-t border-grey-900/10 flex items-center justify-between gap-3">
          <AuthorByline author={author} language={language} />
          <span
            class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-grey-900/5 text-grey-900/40 transition-all duration-300 group-hover:bg-green-dark-900 group-hover:text-white flex-shrink-0"
            aria-hidden="true"
          >
            <ArrowRight className="w-4 h-4" />
          </span>
        </div>
      </div>
    </div>
  </a>
</article>
