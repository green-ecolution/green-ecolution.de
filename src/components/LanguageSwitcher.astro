---
import { SUPPORTED_LANGUAGES, type Language } from '../i18n/languages'
import { getTranslations } from '../i18n/t'

interface Props {
  language: Language
}

const { language } = Astro.props
const t = getTranslations(language, 'common')

// Same route, other prefix: everything after the language segment is reused.
const restOfPath = Astro.url.pathname.split('/').slice(2).join('/')
---

<nav aria-label={t('language.switchTo')}>
  <ul class="flex items-center gap-x-2 lg:gap-x-1">
    {SUPPORTED_LANGUAGES.map((entry) => (
      <li>
        <a
          href={restOfPath ? `/${entry}/${restOfPath}` : `/${entry}`}
          hreflang={entry}
          lang={entry}
          data-lang-switch={entry}
          aria-current={entry === language ? 'page' : undefined}
          class:list={[
            'inline-flex items-center justify-center min-w-11 min-h-11 px-2 text-sm font-semibold rounded transition-colors ease-in-out duration-300 lg:min-w-6 lg:min-h-6 lg:px-1.5 lg:py-1 lg:text-xs',
            entry === language
              ? 'text-white underline underline-offset-4 lg:text-green-dark-900'
              : 'text-white/60 hover:text-green-light-900 lg:text-grey-900/60 lg:hover:text-green-middle-900',
          ]}
        >
          <span class="sr-only">{t(`language.${entry}`)}</span>
          <span aria-hidden="true">{t(`language.${entry}Short`)}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
