---
import { getCollection, render } from 'astro:content'
import { ArrowLeft, ArrowRight, CodeXml } from 'lucide-react'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import AuthorByline from '../../../components/AuthorByline.astro'
import ReleaseChangelog from '../../../components/releases/ReleaseChangelog.astro'
import SectionHeading from '../../../components/releases/SectionHeading.astro'
import GithubIcon from '../../../components/icons/Github.astro'
import ContentImage from '../../../components/content/ContentImage.astro'
import ContentLink from '../../../components/content/ContentLink.astro'
import ContentTable from '../../../components/content/ContentTable.astro'
import { SUPPORTED_LANGUAGES, currentLanguage } from '../../../i18n/languages'
import { getTranslations } from '../../../i18n/t'
import { formatLongDate, isoDate } from '../../../lib/formatDate'
import { selectReleases } from '../../../lib/releaseSelectors'
import { getAdjacentReleases, getReleases, releaseSlug } from '../../../lib/releases'
import { getAuthor } from '../../../lib/authors'
import { splitSlot } from '../../../lib/slotText'
import { pickStrings } from '../../../i18n/pick'
import ReleaseToc from '../../../components/islands/ReleaseToc'

// Only these two need to change the markup: the link to carry the language, the
// table to gain a scroll box. Everything else is styled by .content-body in css.
const contentComponents = { a: ContentLink, img: ContentImage, table: ContentTable }

const DEFAULT_REPOSITORY = 'https://github.com/green-ecolution/green-ecolution'

export async function getStaticPaths() {
  const all = await getCollection('releases')

  // The entry travels as a prop: getStaticPaths already resolved it, so the page
  // does not have to look it up again.
  return SUPPORTED_LANGUAGES.flatMap((lang) =>
    selectReleases(all, lang).map((entry) => ({
      params: { lang, slug: releaseSlug(entry) },
      props: { entry },
    })),
  )
}

const language = currentLanguage(Astro.params.lang)
const { entry } = Astro.props
const slug = releaseSlug(entry)
const { data } = entry
const t = getTranslations(language, 'releases')

const { Content, headings } = await render(entry)
const author = await getAuthor(entry)
const sections = headings.filter((heading) => heading.depth === 2)
const showToc = sections.length >= 3

const releases = await getReleases(language)
const isLatest = releases.length > 0 && releaseSlug(releases[0]) === slug
const { prev, next } = await getAdjacentReleases(language, slug)

const repository = data.repository ?? DEFAULT_REPOSITORY
const feedback = splitSlot(t('detail.feedback.text'), 'issue')

// Exactly the two keys the island needs, never the namespace: releases.json is
// small today but the rule keeps island props from growing with the catalog.
const tocStrings = pickStrings(language, 'releases', ['toc.ariaLabel', 'toc.title'])
const tocEntries = sections.map((heading) => ({ id: heading.slug, label: heading.text }))
---

<BaseLayout
  title={t('detail.meta.title', { version: data.version, title: data.title })}
  description={data.summary}
  language={language}
  path={`/releases/${slug}`}
>
  <main
    id="main-content"
    class="relative overflow-x-clip flex-grow before:bg-cover before:bg-background-yellow-dot before:w-4/5 before:h-[100vh] before:max-h-[45rem] before:absolute before:-right-4 before:-top-16 before:-z-10 before:bg-no-repeat sm:before:-right-10 lg:before:max-h-[55rem] xl:before:w-[70rem] xl:before:-right-40 2xl:before:right-[10%] 2xl:before:bg-contain"
  >
    <article class="px-4 max-w-208 mx-auto mt-20 pb-16 md:px-6 lg:mt-24 lg:pb-24 lg:max-w-screen-lg xl:mt-32 xl:max-w-screen-xl">
      <a
        href={`/${language}/releases`}
        aria-label={t('detail.backToOverviewAriaLabel')}
        class="group inline-flex items-center gap-2 text-green-dark-900 font-semibold hover:gap-3 transition-all mb-8"
      >
        <span
          aria-hidden="true"
          class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-green-dark-900/10 group-hover:bg-green-dark-900 group-hover:text-white transition-all"
        >
          <ArrowLeft className="w-4 h-4" />
        </span>
        <span class="group-hover:underline">{t('detail.backToOverview')}</span>
      </a>

      <header class="mb-10">
        <div class="inline-block mb-4">
          <span class="text-xs font-semibold tracking-widest text-green-light-900 uppercase">
            {t('detail.eyebrow')}
          </span>
          <div class="h-0.5 w-12 bg-gradient-to-r from-green-light-900 to-transparent mt-1"></div>
        </div>

        <div class="flex flex-col gap-3 mb-4 sm:flex-row sm:flex-wrap sm:items-center">
          <div class="flex flex-wrap items-center gap-3">
            <span class="bg-green-dark-900 text-white px-4 py-1.5 rounded-full text-sm font-lato font-bold shadow-xs">
              v{data.version}
            </span>
            {isLatest && (
              <span class="inline-flex items-center bg-green-light-900 text-white px-4 py-1.5 rounded-full text-sm font-lato font-bold shadow-xs">
                {t('badge.current')}
              </span>
            )}
          </div>
          <span class="text-grey-900/30 hidden sm:inline">|</span>
          <div class="flex items-center gap-3">
            <a
              href={`${repository}/releases/tag/v${data.version}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-sm text-grey-900/60 hover:text-green-dark-900 transition-colors"
            >
              <GithubIcon class="w-4 h-4" />
              {t('detail.githubReleaseLabel')}
            </a>
            <a
              href={`${repository}/tree/v${data.version}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-sm text-grey-900/60 hover:text-green-dark-900 transition-colors"
            >
              <CodeXml className="w-4 h-4" aria-hidden="true" />
              {t('detail.sourceLabel')}
            </a>
          </div>
        </div>

        <h1 class="font-lato font-bold text-3xl mb-4 text-grey-900 lg:text-5xl xl:text-6xl">
          {data.title}
        </h1>

        {data.highlights.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {data.highlights.map((highlight) => (
              <span class="bg-green-dark-900/10 text-green-dark-900 px-3 py-1.5 rounded-full text-sm font-medium">
                {highlight}
              </span>
            ))}
          </div>
        )}

        {data.summary && (
          <p class="mt-4 text-lg text-grey-900/80 leading-relaxed lg:text-xl">{data.summary}</p>
        )}

        <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
          <AuthorByline author={author} language={language} />
          <span class="text-grey-900/25" aria-hidden="true">
            |
          </span>
          <p class="text-sm text-grey-900/55">
            <time datetime={isoDate(data.date)}>
              {t('detail.publishedOn', { date: formatLongDate(data.date, language) })}
            </time>
          </p>
        </div>
      </header>

      <div class={showToc ? 'xl:grid xl:grid-cols-[1fr_15rem] xl:gap-10' : ''}>
        <div>
          <div class="content-body">
            <Content components={{ ...contentComponents, h2: SectionHeading }} />
          </div>

          {data.changelog.length > 0 && (
            <div class="mt-8">
              <ReleaseChangelog
                version={data.version}
                entries={data.changelog}
                repository={repository}
                language={language}
              />
            </div>
          )}
        </div>

        {showToc && (
          <aside class="hidden xl:block">
            <ReleaseToc entries={tocEntries} strings={tocStrings} client:visible />
          </aside>
        )}
      </div>

      <nav
        aria-label={t('detail.navAriaLabel')}
        class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-4"
      >
        {prev ? (
          <a
            href={`/${language}/releases/${releaseSlug(prev)}`}
            class="group p-5 rounded-2xl border border-grey-200 bg-white hover:border-green-dark-900/30 hover:shadow-lg transition-all"
          >
            <span class="text-xs text-grey-500 uppercase tracking-wide font-semibold">
              {t('detail.newerVersion')}
            </span>
            <div class="flex items-center gap-3 mt-2">
              <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-grey-100 text-grey-400 group-hover:bg-green-dark-900 group-hover:text-white transition-all flex-shrink-0">
                <ArrowLeft className="w-4 h-4" aria-hidden="true" />
              </span>
              <div class="min-w-0">
                <span class="font-lato font-bold text-grey-900 group-hover:text-green-dark-900 transition-colors">
                  v{prev.data.version}
                </span>
                <p class="text-sm text-grey-600 line-clamp-1">{prev.data.title}</p>
              </div>
            </div>
          </a>
        ) : (
          <div />
        )}
        {next ? (
          <a
            href={`/${language}/releases/${releaseSlug(next)}`}
            class="group p-5 rounded-2xl border border-grey-200 bg-white hover:border-green-dark-900/30 hover:shadow-lg transition-all sm:text-right"
          >
            <span class="text-xs text-grey-500 uppercase tracking-wide font-semibold">
              {t('detail.olderVersion')}
            </span>
            <div class="flex items-center gap-3 mt-2 sm:justify-end">
              <div class="min-w-0">
                <span class="font-lato font-bold text-grey-900 group-hover:text-green-dark-900 transition-colors">
                  v{next.data.version}
                </span>
                <p class="text-sm text-grey-600 line-clamp-1">{next.data.title}</p>
              </div>
              <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-grey-100 text-grey-400 group-hover:bg-green-dark-900 group-hover:text-white transition-all flex-shrink-0">
                <ArrowRight className="w-4 h-4" aria-hidden="true" />
              </span>
            </div>
          </a>
        ) : (
          <div />
        )}
      </nav>

      <div class="mt-10 pt-6 border-t border-grey-100 text-center">
        <p class="text-grey-900/60 text-sm">
          {feedback.before}
          <a
            href={`${repository}/issues/new`}
            target="_blank"
            rel="noopener noreferrer"
            class="text-green-dark-900 hover:underline font-medium"
          >
            {feedback.inner}
          </a>
          {feedback.after}
        </p>
      </div>
    </article>
  </main>
</BaseLayout>
