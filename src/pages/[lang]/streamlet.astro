---
import BaseLayout from '../../layouts/BaseLayout.astro'
import BreadcrumbSchema from '../../components/BreadcrumbSchema.astro'
import StreamletApi from '../../components/sections/streamlet/StreamletApi.astro'
import StreamletBenefit from '../../components/sections/streamlet/StreamletBenefit.astro'
import StreamletFit from '../../components/sections/streamlet/StreamletFit.astro'
import StreamletHero from '../../components/sections/streamlet/StreamletHero.astro'
import StreamletOperations from '../../components/sections/streamlet/StreamletOperations.astro'
import StreamletProblem from '../../components/sections/streamlet/StreamletProblem.astro'
import StreamletSolver from '../../components/sections/streamlet/StreamletSolver.astro'
import StreamletStatus from '../../components/sections/streamlet/StreamletStatus.astro'
import StreamletTechIntro from '../../components/sections/streamlet/StreamletTechIntro.astro'
import StreamletTiles from '../../components/sections/streamlet/StreamletTiles.astro'
import { getTranslations } from '../../i18n/t'
import { languagePaths } from '../../lib/languagePaths'
import { currentLanguage } from '../../i18n/languages'

export const getStaticPaths = languagePaths

const language = currentLanguage(Astro.params.lang)
const t = getTranslations(language, 'streamlet')
const tc = getTranslations(language, 'common')
---

<BaseLayout
  title={t('meta.title')}
  description={t('meta.description')}
  language={language}
  path="/streamlet"
>
  <BreadcrumbSchema
    language={language}
    items={[
      { name: tc('breadcrumb.home'), path: '' },
      { name: tc('breadcrumb.streamlet'), path: '/streamlet' },
    ]}
  />
  <main id="main-content">
    <StreamletHero language={language} />
    <StreamletProblem language={language} />
    <StreamletBenefit language={language} />
    <StreamletFit language={language} />
    <StreamletTechIntro language={language} />
    <StreamletApi language={language} />
    <StreamletSolver language={language} />
    <StreamletTiles language={language} />
    <StreamletOperations language={language} />
    <StreamletStatus language={language} />
  </main>
</BaseLayout>
