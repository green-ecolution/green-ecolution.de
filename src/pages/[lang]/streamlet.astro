---
import BaseLayout from '../../layouts/BaseLayout.astro'
import BreadcrumbSchema from '../../components/BreadcrumbSchema.astro'
import StreamletBenefit from '../../components/sections/streamlet/StreamletBenefit.astro'
import StreamletClosing from '../../components/sections/streamlet/StreamletClosing.astro'
import StreamletFit from '../../components/sections/streamlet/StreamletFit.astro'
import StreamletHero from '../../components/sections/streamlet/StreamletHero.astro'
import StreamletProblem from '../../components/sections/streamlet/StreamletProblem.astro'
import { getTranslations } from '../../i18n/t'
import { languagePaths } from '../../lib/languagePaths'
import { currentLanguage } from '../../i18n/languages'

export const getStaticPaths = languagePaths

const language = currentLanguage(Astro.params.lang)
const t = getTranslations(language, 'streamlet')
const tc = getTranslations(language, 'common')
---

<BaseLayout
  title={t('meta.title')}
  description={t('meta.description')}
  language={language}
  path="/streamlet"
>
  <BreadcrumbSchema
    language={language}
    items={[
      { name: tc('breadcrumb.home'), path: '' },
      { name: tc('breadcrumb.streamlet'), path: '/streamlet' },
    ]}
  />
  <main id="main-content">
    <StreamletHero language={language} />
    <StreamletProblem language={language} />
    <StreamletBenefit language={language} />
    <StreamletFit language={language} />
    <StreamletClosing language={language} />
  </main>
</BaseLayout>
