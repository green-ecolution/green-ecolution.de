---
import BaseLayout from '../../layouts/BaseLayout.astro'
import BreadcrumbSchema from '../../components/BreadcrumbSchema.astro'
import HomepageHero from '../../components/homepage/HomepageHero.astro'
import HomepageDevider from '../../components/homepage/HomepageDevider.astro'
import AwardBanner from '../../components/homepage/AwardBanner.astro'
import Introduction from '../../components/sections/Introduction.astro'
import Challenge from '../../components/sections/Challenge.astro'
import TargetGroups from '../../components/sections/TargetGroups.astro'
import Features from '../../components/sections/Features.astro'
import SensorProbe from '../../components/sections/SensorProbe.astro'
import Videos from '../../components/sections/Videos.astro'
import ProcessCompact from '../../components/sections/ProcessCompact.astro'
import DemoInstance from '../../components/sections/DemoInstance.astro'
import LatestRelease from '../../components/sections/LatestRelease.astro'
import Stakeholder from '../../components/sections/Stakeholder.astro'
import Faq from '../../components/sections/Faq.astro'
import ContactSection from '../../components/sections/ContactSection.astro'
import { getTranslations } from '../../i18n/t'
import { languagePaths } from '../../lib/languagePaths'
import { currentLanguage } from '../../i18n/languages'

export const getStaticPaths = languagePaths

const language = currentLanguage(Astro.params.lang)
const t = getTranslations(language, 'home')
const tc = getTranslations(language, 'common')
---

<BaseLayout title={t('meta.title')} description={t('meta.description')} language={language} path="">
  <BreadcrumbSchema language={language} items={[{ name: tc('breadcrumb.home'), path: '' }]} />

  <main id="main-content">
    <HomepageHero language={language} />
    <HomepageDevider />
    <AwardBanner language={language} />
    <Introduction language={language} />
    <Challenge language={language} />
    <TargetGroups language={language} />
    <Features language={language} />
    <SensorProbe language={language} />
    <Videos language={language} />
    <ProcessCompact language={language} />
    <DemoInstance language={language} />
    <LatestRelease language={language} />
    <div class="relative overflow-hidden before:bg-cover before:bg-background-light-dot before:w-[90%] before:h-[120vh] before:max-w-[60rem] before:absolute before:-right-4 before:top-8 before:-z-10 before:bg-no-repeat sm:before:-right-[5%] 2xl:before:w-[90rem] 2xl:before:max-w-[90rem] 2xl:before:right-[10%] 2xl:before:bg-contain 3xl:before:right-[20%]">
      <Stakeholder language={language} />
      <Faq language={language} />
      <ContactSection language={language} />
    </div>
  </main>
</BaseLayout>
