---
import BaseLayout from '../../layouts/BaseLayout.astro'
import BreadcrumbSchema from '../../components/BreadcrumbSchema.astro'
import Hero from '../../components/Hero.astro'
import PressBoilerplate from '../../components/sections/press/PressBoilerplate.astro'
import PressContact from '../../components/sections/press/PressContact.astro'
import PressImages from '../../components/sections/press/PressImages.astro'
import PressLogos from '../../components/sections/press/PressLogos.astro'
import PressMentions from '../../components/sections/press/PressMentions.astro'
import PressPitchDeck from '../../components/sections/press/PressPitchDeck.astro'
import { getTranslations } from '../../i18n/t'
import { languagePaths } from '../../lib/languagePaths'
import { currentLanguage } from '../../i18n/languages'

export const getStaticPaths = languagePaths

const language = currentLanguage(Astro.params.lang)
const t = getTranslations(language, 'press')
const tc = getTranslations(language, 'common')
---

<BaseLayout
  title={t('meta.title')}
  description={t('meta.description')}
  language={language}
  path="/presse"
>
  <BreadcrumbSchema
    language={language}
    items={[
      { name: tc('breadcrumb.home'), path: '' },
      { name: tc('breadcrumb.press'), path: '/presse' },
    ]}
  />
  <main
    id="main-content"
    class="relative overflow-hidden before:bg-cover before:bg-background-dark-dot before:w-4/5 before:h-[100vh] before:max-h-[45rem] before:absolute before:-right-4 before:-top-16 before:-z-10 before:bg-no-repeat sm:before:-right-10 lg:before:max-h-[55rem] xl:before:w-[70rem] xl:before:-right-40 2xl:before:right-[10%] 2xl:before:bg-contain"
  >
    <Hero
      headline={t('hero.headline')}
      description={t('hero.description')}
      label={t('hero.label')}
    />

    <PressContact language={language} />
    <PressLogos language={language} />
    <PressImages language={language} />
    <PressPitchDeck language={language} />
    <PressBoilerplate language={language} />
    <PressMentions language={language} />
  </main>
</BaseLayout>
