---
import BaseLayout from '../layouts/BaseLayout.astro'
import CableAnimation from '../components/islands/CableAnimation'
import Arrow from '../components/icons/Arrow.astro'
import { getTranslations } from '../i18n/t'
import { DEFAULT_LANGUAGE } from '../i18n/languages'

// One 404 page, in German, without language variants: nginx would otherwise have
// to derive a language from a path that by definition belongs to no page.
const t = getTranslations(DEFAULT_LANGUAGE, 'common')
---

<BaseLayout title={t('notFound.metaTitle')} language={DEFAULT_LANGUAGE}>
  <main
    id="main-content"
    class="relative h-screen overflow-hidden before:bg-cover before:bg-background-dark-dot before:w-4/5 before:h-[100vh] before:max-h-[45rem] before:absolute before:-right-4 before:-top-16 before:-z-10 before:bg-no-repeat sm:before:-right-10 lg:before:max-h-[55rem] xl:before:w-[70rem] xl:before:-right-40 2xl:before:right-[10%] 2xl:before:bg-contain"
  >
    <figure aria-hidden="true" class="absolute top-0 inset-x-0">
      <CableAnimation client:load />
    </figure>

    <div class="mt-[55vh] mx-auto max-w-208 xl:max-w-screen-lg">
      <section class="my-28 px-4 md:px-6 lg:my-36 xl:my-52">
        <h1 class="font-lato font-bold text-4xl mb-4 lg:mb-6 lg:text-5xl lg:text-center xl:text-6xl">
          {t('notFound.title')}
        </h1>
        <p class="lg:text-center mb-10">{t('notFound.description')}</p>
        <div class="lg:flex lg:items-center lg:justify-center">
          <a
            href={`/${DEFAULT_LANGUAGE}`}
            aria-label={t('notFound.cta')}
            class="flex items-center justify-center gap-x-4 rounded-2xl w-max font-semibold px-5 py-2 group cursor-pointer transition-all ease-in-out duration-300 text-white bg-green-dark-900 hover:bg-green-light-900 hover:shadow-lg hover:shadow-green-light-900/40 hover:-translate-y-0.5"
          >
            <span>{t('notFound.cta')}</span>
            <Arrow class="w-6 text-white transition-all ease-in-out duration-300 group-hover:translate-x-2" />
          </a>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
